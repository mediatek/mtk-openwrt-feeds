---
[v1] arm64: dts: mediatek: Remove spi ipm design compatible

Remove spi ipm design compatible for mt7981/mt7986/mt7988.
"mediatek,spi-ipm" related settings name the SPI IP design, not the SoC itself.
Upstream environment tends to keeping compatible strings SoC specific, so
design based matching cannot be kept.
---
v1: Rename compatibles to SoC specific naming
---

--- a/arch/arm64/boot/dts/mediatek/mt7981b.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt7981b.dtsi
@@ -241,7 +241,7 @@
 		};
 
 		spi2: spi@11009000 {
-			compatible = "mediatek,mt7981-spi-ipm", "mediatek,spi-ipm";
+			compatible = "mediatek,mt7981-spi";
 			reg = <0 0x11009000 0 0x1000>;
 			interrupts = <GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&topckgen CLK_TOP_CB_M_D2>,
@@ -255,7 +255,7 @@
 		};
 
 		spi0: spi@1100a000 {
-			compatible = "mediatek,mt7981-spi-ipm", "mediatek,spi-ipm";
