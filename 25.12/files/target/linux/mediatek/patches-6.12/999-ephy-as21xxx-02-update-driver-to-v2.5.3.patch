+}
+
+int aeon_set_rmt_lpbk_proc(const char *val_string, struct parsed_cmd *cmdinfo, struct phy_device *phydev)
+{
+	unsigned short value;
+
+	if (!strcmp(cmdinfo->cmd, "eth")) {
+		aeon_ipc_sync_parity(phydev);
+		aeon_sds_pcs_set_cfg(NORMAL, 3, 0, phydev);
+		aeon_set_rmt_lpbk_cfg(RMT_LPBK, phydev);
+		msleep(300);
+		aeon_sds_restart(0, phydev);
+		msleep(300);
+		aeon_sds_restart(0, phydev);
+		pr_info("  Set eth loopback successfully\n");
+	} else if (!strcmp(cmdinfo->cmd, "sds")) {
+		value = aeon_cl45_read(phydev, 0x1e, 0x2);
+		value |= BIT(15);
+		aeon_cl45_write(phydev, 0x1e, 0x2, value);
+
+		value = aeon_cl45_read(phydev, 0x1, 0x90a);
+		value &= ~BIT(0);
+		value |= BIT(1);
+		value &= ~(0x7 << 10);
+		value |= ((3 & 0x7) << 10);
+		aeon_cl45_write(phydev, 0x1, 0x90a, value);
+
+		msleep(100);
+
+		value = aeon_cl45_read(phydev, 3, 0x8829);
+		value |= BIT(7);
+		aeon_cl45_write(phydev, 3, 0x8829, value);
+
+		msleep(200);
+
+		value = aeon_cl45_read(phydev, 3, 0x8829);
+		value |= BIT(1);
+		aeon_cl45_write(phydev, 3, 0x8829, value);
+
+		msleep(100);
+
+		value = aeon_cl45_read(phydev, 0x1e, 0x2);
+		value &= ~BIT(15);
+		aeon_cl45_write(phydev, 0x1e, 0x2, value);
+		pr_info("  Set sds loopback successfully\n");
+	} else {
+		return -EINVAL;
+	}
+	return 0;
+}
