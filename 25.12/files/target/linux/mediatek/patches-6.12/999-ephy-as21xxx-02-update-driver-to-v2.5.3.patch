+int aeon_100bt_tm_adj(int adj_add, struct phy_device *phydev)
+{
+	int val, ret;
+	int adj;
+
+	val = aeon_cl45_read(phydev, 2, 0x301);
+	if (val < 0)
+		return val;
+
+	adj = (val >> 8) & 0xf;
+
+	adj += adj_add;
+	if (adj > 15)
+		adj = 15;
+	if (adj < 0)
+		adj = 0;
+
+	val = (val & ~(0xf << 8)) | (adj << 8);
+
+	aeon_cl45_write(phydev, 2, 0x301, val);
+
+	val = aeon_cl45_read(phydev, 2, 0x301);
+	if (val < 0)
+		return val;
+
+	adj = (val >> 8) & 0xf;
+
+	return ret;
+}
