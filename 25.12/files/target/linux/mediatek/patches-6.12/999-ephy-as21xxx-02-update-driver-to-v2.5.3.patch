+/*
+ * PHY LED drivers typically do not support software brightness control.
+ * Only hardware triggers (netdev/link/activity) are supported.
+ * Implement brightness_set as a no-op to avoid overwriting hardware trigger configuration.
+ */
+static int aeon_led_brightness_set(struct phy_device *phydev,
+				   u8 index, enum led_brightness value)
+{
+	/* Nothing to do, hardware controls LED state */
+	return 0;
+}
+
+static int aeon_led_hw_is_supported(struct phy_device *phydev, u8 index,
+				    unsigned long rules)
+{
+	int i;
+
+	if (index > AEON_MAX_LEDS)
+		return -EINVAL;
+
+	for (i = 0; i < ARRAY_SIZE(as2xxxx_led_supported_pattern); i++)
+		if (rules == as2xxxx_led_supported_pattern[i].pattern)
+			return 0;
+
+	return -EOPNOTSUPP;
+}
+
+static int aeon_led_hw_control_get(struct phy_device *phydev, u8 index,
+				   unsigned long *rules)
+{
+	int i, val = -1;
+
+	if (index > AEON_MAX_LEDS)
+		return -EINVAL;
+
+	if (index == AEON_LED0) {
+		for (i = 0; i < ARRAY_SIZE(as2xxxx_led_map); i++)
+			if (custome_cfg[0] == as2xxxx_led_map[i].mode)
+				val = as2xxxx_led_map[i].map;
+	} else if (index == AEON_LED1) {
+		for (i = 0; i < ARRAY_SIZE(as2xxxx_led_map); i++)
+			if (custome_cfg[1] == as2xxxx_led_map[i].mode)
+				val = as2xxxx_led_map[i].map;
+	} else if (index == AEON_LED2) {
+		for (i = 0; i < ARRAY_SIZE(as2xxxx_led_map); i++)
+			if (custome_cfg[2] == as2xxxx_led_map[i].mode)
+				val = as2xxxx_led_map[i].map;
+	} else if (index == AEON_LED3) {
+		for (i = 0; i < ARRAY_SIZE(as2xxxx_led_map); i++)
+			if (custome_cfg[3] == as2xxxx_led_map[i].mode)
+				val = as2xxxx_led_map[i].map;
+	} else if (index == AEON_LED4) {
+		for (i = 0; i < ARRAY_SIZE(as2xxxx_led_map); i++)
+			if (custome_cfg[4] == as2xxxx_led_map[i].mode)
+				val = as2xxxx_led_map[i].map;
+	} else {
+		phydev_dbg(phydev, "AEON support five leds, check index\r\n");
+	}
+
+	for (i = 0; i < ARRAY_SIZE(as2xxxx_led_supported_pattern); i++)
+		if (val == as2xxxx_led_supported_pattern[i].val) {
+			*rules = as2xxxx_led_supported_pattern[i].pattern;
+			return 0;
+		}
+
+	/* Should be impossible */
+	return -EINVAL;
+}
+
+static int aeon_led_hw_control_set(struct phy_device *phydev, u8 index,
+				   unsigned long rules)
+{
+	int i;
+	u16 vend_event = 0;
+	u16 hw_mode = 0;
+
+	if (index > AEON_MAX_LEDS)
+		return -EINVAL;
+
+	/* 1. find VEND1 event from rules */
+	for (i = 0; i < ARRAY_SIZE(as2xxxx_led_supported_pattern); i++) {
+		if (as2xxxx_led_supported_pattern[i].pattern == rules) {
+			vend_event = as2xxxx_led_supported_pattern[i].val;
+			break;
+		}
+	}
+
+	if (!vend_event)
+		return -EINVAL;
+
+	/* 2. find hw mode form VEND1 event */
+	for (i = 0; i < ARRAY_SIZE(as2xxxx_led_map); i++) {
+		if (as2xxxx_led_map[i].map == vend_event) {
+			hw_mode = as2xxxx_led_map[i].mode;
+			break;
+		}
+	}
+
+	if (!hw_mode)
+		return -EINVAL;
+
+	/* 3. save hw mode */
+	switch (index) {
+	case AEON_LED0:
+		custome_cfg[0] = hw_mode;
+		break;
+	case AEON_LED1:
+		custome_cfg[1] = hw_mode;
+		break;
+	case AEON_LED2:
+		custome_cfg[2] = hw_mode;
+		break;
+	case AEON_LED3:
+		custome_cfg[3] = hw_mode;
+		break;
+	case AEON_LED4:
+		custome_cfg[4] = hw_mode;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	aeon_ipc_set_led_cfg(custome_cfg[0], custome_cfg[1], custome_cfg[2],
+			     custome_cfg[3], custome_cfg[4],
+			     custome_cfg[5], custome_cfg[6], phydev);
+
+	return 0;
+}
+
+static int aeon_led_polarity_set(struct phy_device *phydev, int index,
+					unsigned long modes)
+{
+	bool led_active_low = false;
+	u32 mode;
+
+	if (index > AEON_MAX_LEDS)
+		return -EINVAL;
+
+	for_each_set_bit(mode, &modes, __PHY_LED_MODES_NUM) {
+		switch (mode) {
+		case PHY_LED_ACTIVE_LOW:
+			led_active_low = true;
+			break;
+		case PHY_LED_ACTIVE_HIGH: /* default mode */
+			led_active_low = false;
+			break;
+		default:
+			return -EINVAL;
+		}
+	}
+
+	if (led_active_low)
+		custome_cfg[5] |= (1 << index);
+
+	aeon_ipc_set_led_cfg(custome_cfg[0], custome_cfg[1], custome_cfg[2],
+			     custome_cfg[3], custome_cfg[4],
+			     custome_cfg[5], custome_cfg[6], phydev);
+
+return 0;
+}
+
+static void aeon_cl45_write_burst(struct phy_device *phydev, unsigned int dev_addr,
+				  unsigned int phy_reg, const unsigned char *data,
+				  int size)
+{
+	unsigned short write_data = 0, i = 0;
+
+	for (i = 0; i < size; i += 2) {
+		write_data = (data[i + 1] << 8) | data[i];
+		phy_write_mmd(phydev, dev_addr, phy_reg, write_data);
+	}
+}
+
+static int aeon_set_default_value(struct phy_device *phydev)
+{
+	static const unsigned char base_data[] = {0x32, 0x30, 0x32, 0x33, 0x30, 0x37, 0x31, 0x34};
+	unsigned char bytebuf[16];
+	unsigned short *wdata;
+	unsigned int mask;
+	int byte_count, wdata_count = 0;
+	int pos = 0, val, ret = 0, remaining;
+	unsigned char padded_bytes[MEM_WORD_SIZE] = {0};
+
+	mask = param1 | 14;
+	memcpy(bytebuf, base_data, sizeof(base_data));
+	bytebuf[8] = mask & 0xff;
+	bytebuf[9] = (mask >> 8) & 0xff;
+	byte_count = 10;
+
+	wdata = kmalloc_array(MAX_WDATA_SIZE, sizeof(unsigned short), GFP_KERNEL);
+	if (!wdata)
+		return -ENOMEM;
+
+	while (pos + MEM_WORD_SIZE <= byte_count) {
+		if (wdata_count + 2 > MAX_WDATA_SIZE) {
+			pr_err("wdata array overflow\n");
+			ret = -ENOSPC;
+			goto cleanup;
+		}
+
+		wdata[wdata_count++] = le16_to_cpu(*(unsigned short *)&bytebuf[pos]);
+		wdata[wdata_count++] = le16_to_cpu(*(unsigned short *)&bytebuf[pos + 2]);
+
+		pos += MEM_WORD_SIZE;
+	}
+
+	remaining = byte_count - pos;
+	if (remaining > 0) {
+		if (wdata_count + 2 <= MAX_WDATA_SIZE) {
+			/* Here we just need padded_bytes once, otherwise we need to read from mem */
+			memcpy(padded_bytes, &bytebuf[pos], remaining);
+
+			wdata[wdata_count++] = le16_to_cpu(*(unsigned short *)&padded_bytes[0]);
+			wdata[wdata_count++] = le16_to_cpu(*(unsigned short *)&padded_bytes[2]);
+		}
+	}
+
+	val = aeon_cl45_read(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_CPU_CTRL);
+	val |= 0x12;
+	phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_CPU_CTRL, val);
+
+	phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_FW_START_ADDR, (u16)(AEON_MEM_DEFAULT_ADDR & 0xFFFF));
+
+	aeon_phy_modify_mmd(phydev, MDIO_MMD_VEND1,
+			    VEND1_GLB_REG_MDIO_INDIRECT_ADDRCMD,
+			    0x3ffc, 0xc000);
+
+	aeon_cl45_write_burst(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_MDIO_INDIRECT_LOAD, (unsigned char *)wdata, wdata_count * 2);
+
+	val = aeon_cl45_read(phydev, MDIO_MMD_VEND1,
+			     VEND1_GLB_REG_MDIO_INDIRECT_ADDRCMD);
+	val &= 0x3FFF;
+	phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_MDIO_INDIRECT_ADDRCMD, val);
+
+	val = aeon_cl45_read(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_CPU_CTRL);
+	val &= 0xFFED;
+	phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_CPU_CTRL, val);
+
+cleanup:
+	kfree(wdata);
+	return ret;
+}
+
+static void as21xxx_set_fast_mdc_timing(struct phy_device *phydev)
+{
+	phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x53, 0xFFFF);
+	phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x54, 0xFFFF);
+	phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x55, 0xFFFF);
+}
+
+static int as21xxx_match_phy_device(struct phy_device *phydev,
+				    const struct phy_driver *phydrv)
+{
+	struct as2xxxx_priv *priv;
+	u16 ret_sts;
+	u32 phy_id;
+	int ret;
+	int cnt = 0;
+
+	phydev->c45_ids.mmds_present |= MDIO_DEVS_PMAPMD | MDIO_DEVS_PCS | MDIO_DEVS_AN;
+
+	/* Read PHY ID to handle firmware loaded or HW reset */
+	ret = phy_read_mmd(phydev, MDIO_MMD_PCS, MII_PHYSID1);
+	/*as21xxx patch start*/
+	as21xxx_mdio_patch(phydev);
+	/*as21xxx patch end*/
+	if (ret < 0)
+		return ret;
+	phy_id = ret << 16;
+
+	ret = phy_read_mmd(phydev, MDIO_MMD_PCS, MII_PHYSID2);
+	/*as21xxx patch start*/
+	as21xxx_mdio_patch(phydev);
+	/*as21xxx patch end*/
+	if (ret < 0)
+		return ret;
+	phy_id |= ret;
+
+	pr_info("As21xxx v1.0 Detected ID %x for %x\n", phy_id, phydev->mdio.addr);
+
+	/* With PHY ID not the generic AS21xxx one assume
+	 * the firmware just loaded
+	 */
+	if (phy_id != PHY_ID_AS21XXX_AN8831)
+		return genphy_match_phy_device(phydev, (struct phy_driver *)phydrv);
+
+	phydev->phy_id = phy_id;
+
+	pr_info("Force enabling PTP clock for %x\n", phydev->mdio.addr);
+	phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_PTP_CLK, 0x48);
+
+	pr_info("Loading Firmware\n");
+
+	/* Allocate temp priv and load the firmware */
+	priv = kzalloc(sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	mutex_init(&priv->ipc_lock);
+
+	aeon_set_default_value(phydev);
+	if (ret < 0)
+		goto out;
+
+	pr_info("set fast_mdc\n");
+	as21xxx_set_fast_mdc_timing(phydev);
+
+	/* Enable PTP clk if not already Enabled */
+	ret = phy_set_bits_mmd(phydev, MDIO_MMD_VEND1, VEND1_PTP_CLK,
+				   VEND1_PTP_CLK_EN);
+	if (ret)
+		goto out;
+
+	do {
+		ret = aeon_firmware_load(phydev);
+		/* Sync parity */
+		if (ret == 0) {
+			ret = aeon_ipc_sync_parity(phydev, priv);
+			if (ret == 0) {
+				pr_info("AS21xxx(AN8831) Load Firmware Succ\n");
+				break;
+			}
+		}
+		cnt++;
+		phy_device_reset(phydev, 1);
+		usleep_range(5000, 6000);
+		phy_device_reset(phydev, 0);
+		usleep_range(5000, 6000);
+		pr_info("AS21xxx(AN8831) Load Firmware Again!!\n");
+	} while (cnt < FW_LOAD_TRY_NUM);
+
+	if (ret) {
+		phydev_err(phydev, "AS21xxx(AN8831) Load Firmware Failed!!!\n");
+		goto out;
+	}
+
+	/* send a third NOOP cmd to wait for firmware finish loading */
+	ret = aeon_ipc_noop(phydev, priv, &ret_sts);
+	if (ret) {
+		ret = aeon_firmware_load(phydev);
+		if (ret)
+			goto out;
+	}
+	mdelay(100);
+	as21xxx_set_fast_mdc_timing(phydev);
+	mdelay(100);
+
+out:
+	mutex_destroy(&priv->ipc_lock);
+	kfree(priv);
+
+	/* Return can either be 0 or a negative error code.
+	 * Returning 0 here means THIS is NOT a suitable PHY.
+	 *
+	 * For the specific case of the generic Aeonsemi PHY ID that
+	 * needs the firmware the be loaded first to have a correct PHY ID,
+	 * this is OK as a matching PHY ID will be found right after.
+	 * This relies on the driver probe order where the first PHY driver
+	 * probed is the generic one.
+	 */
+	pr_info("Returning %d for device %x\n", ret, phydev->mdio.addr);
+	return 1;
+}
+
+static int as22xxx_match_phy_device(struct phy_device *phydev,
+				    const struct phy_driver *phydrv)
+{
+	struct as2xxxx_priv *priv;
+	u16 ret_sts;
+	u32 phy_id;
+	int ret;
+	int cnt = 0;
+
+	phydev->c45_ids.mmds_present |= MDIO_DEVS_PMAPMD | MDIO_DEVS_PCS | MDIO_DEVS_AN;
+
+	/* Read PHY ID to handle firmware loaded or HW reset */
+	ret = aeon_cl45_read(phydev, MDIO_MMD_PCS, MII_PHYSID1);
+	if (ret < 0)
+		return ret;
+	phy_id = ret << 16;
+
+	ret = aeon_cl45_read(phydev, MDIO_MMD_PCS, MII_PHYSID2);
+	if (ret < 0)
+		return ret;
+	phy_id |= ret;
+
+	pr_info("As22xxx Detected ID %x for %x\n", phy_id, phydev->mdio.addr);
+
+	/* With PHY ID not the generic AS22xxx one assume
+	 * the firmware just loaded
+	 */
+	if (phy_id != PHY_ID_AS22XXX_AN8833)
+		return genphy_match_phy_device(phydev, (struct phy_driver *)phydrv);
+
+	phydev->phy_id = phy_id;
+
+	pr_info("Loading Firmware\n");
+
+	/* Allocate temp priv and load the firmware */
+	priv = kzalloc(sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	mutex_init(&priv->ipc_lock);
+
+	aeon_set_default_value(phydev);
+
+	do {
+		ret = aeon_firmware_load(phydev);
+		/* Sync parity */
+		if (ret == 0) {
+			ret = aeon_ipc_sync_parity(phydev, priv);
+			if (ret == 0) {
+				pr_info("AS22xxx(AN8833) Load Firmware Succ\n");
+				break;
+			}
+		}
+		cnt++;
+		phy_device_reset(phydev, 1);
+		usleep_range(5000, 6000);
+		phy_device_reset(phydev, 0);
+		usleep_range(5000, 6000);
+		pr_info("AS22xxx(AN8833) Load Firmware Again!!\n");
+	} while (cnt < FW_LOAD_TRY_NUM);
+
+	if (ret) {
+		phydev_err(phydev, "AS22xxx(AN8833) Load Firmware Failed!!!\n");
+		goto out;
+	}
+
+	/* send a third NOOP cmd to wait for firmware finish loading */
+	ret = aeon_ipc_noop(phydev, priv, &ret_sts);
+	if (ret) {
+		ret = aeon_firmware_load(phydev);
+		if (ret)
+			goto out;
+	}
+
+out:
+	mutex_destroy(&priv->ipc_lock);
+	kfree(priv);
+
+	/* Return can either be 0 or a negative error code.
+	 * Returning 0 here means THIS is NOT a suitable PHY.
+	 *
+	 * For the specific case of the generic Aeonsemi PHY ID that
+	 * needs the firmware the be loaded first to have a correct PHY ID,
+	 * this is OK as a matching PHY ID will be found right after.
+	 * This relies on the driver probe order where the first PHY driver
+	 * probed is the generic one.
+	 */
+	pr_info("Returning %d for device %x\n", ret, phydev->mdio.addr);
+	return 1;
+}
+
+static int as2xxxx_c45_an_disable_aneg(struct phy_device *phydev)
+{
+	return aeon_phy_clear_bits_mmd(phydev, MDIO_MMD_AN, MDIO_CTRL1,
+				       MDIO_AN_CTRL1_ENABLE | MDIO_AN_CTRL1_RESTART);
+}
+
+static int as2xxxx_c45_pma_setup_forced(struct phy_device *phydev)
+{
+	int ctrl1, ctrl2;
+
+	/* Half duplex is not supported */
+	if (phydev->duplex != DUPLEX_FULL)
+		return -EINVAL;
+
+	ctrl1 = aeon_cl45_read(phydev, MDIO_MMD_PMAPMD, MDIO_CTRL1);
+	if (ctrl1 < 0)
+		return ctrl1;
+
+	ctrl2 = aeon_cl45_read(phydev, MDIO_MMD_PMAPMD, MDIO_CTRL2);
+	if (ctrl2 < 0)
+		return ctrl2;
+
+	ctrl1 &= ~MDIO_CTRL1_SPEEDSEL;
+	/*
+	 * PMA/PMD type selection is 1.7.5:0 not 1.7.3:0.  See 45.2.1.6.1
+	 * in 802.3-2012 and 802.3-2015.
+	 */
+	ctrl2 &= ~(MDIO_PMA_CTRL2_TYPE | 0x30);
+
+	switch (phydev->speed) {
+	case SPEED_10:
+		ctrl2 |= MDIO_PMA_CTRL2_10BT;
+		break;
+	case SPEED_100:
+		ctrl1 |= MDIO_PMA_CTRL1_SPEED100;
+		ctrl2 |= MDIO_PMA_CTRL2_100BTX;
+		break;
+	case SPEED_1000:
+		ctrl1 |= MDIO_PMA_CTRL1_SPEED1000;
+		/* Assume 1000base-T */
+		ctrl2 |= MDIO_PMA_CTRL2_1000BT;
+		break;
+	case SPEED_2500:
+		ctrl1 |= MDIO_CTRL1_SPEED2_5G;
+		/* Assume 2.5Gbase-T */
+		ctrl2 |= MDIO_PMA_CTRL2_2_5GBT;
+		break;
+	case SPEED_5000:
+		ctrl1 |= MDIO_CTRL1_SPEED5G;
+		/* Assume 5Gbase-T */
+		ctrl2 |= MDIO_PMA_CTRL2_5GBT;
+		break;
+	case SPEED_10000:
+		ctrl1 |= MDIO_CTRL1_SPEED10G;
+		/* Assume 10Gbase-T */
+		ctrl2 |= MDIO_PMA_CTRL2_10GBT;
+		break;
+	}
+
+	phy_write_mmd(phydev, MDIO_MMD_PMAPMD, MDIO_CTRL1, ctrl1);
+
+	phy_write_mmd(phydev, MDIO_MMD_PMAPMD, MDIO_CTRL2, ctrl2);
+
+	return as2xxxx_c45_an_disable_aneg(phydev);
+}
+
+static int as2xxxx_c45_restart_aneg(struct phy_device *phydev)
+{
+	return aeon_phy_set_bits_mmd(phydev, MDIO_MMD_AN, MDIO_CTRL1,
+				     MDIO_AN_CTRL1_ENABLE | MDIO_AN_CTRL1_RESTART);
+}
+
+static unsigned int get_par(struct phy_device *phydev)
+{
+	struct as2xxxx_priv *priv = phydev->priv;
+
+	return priv->ipc_cmd_num & 0x1;
+}
+
+static void aeon_ipc_build_cmd(struct phy_device *phydev, unsigned short *cmd, short opcode, short size)
+{
+	struct as2xxxx_priv *priv = phydev->priv;
+/*
+ * """Construct the full command word.
+ * 16-bit register is laid out as follows:
+ * [1 cmd par][4 reserved][5 size][6 opcode]
+ */
+
+	unsigned short opcode_mask = (1 << IPC_NB_OPCODE) - 1;
+	unsigned short size_mask = (1 << IPC_PAYLOAD_NB) - 1;
+	unsigned short opcode_bits = opcode & opcode_mask;
+	unsigned short size_bits = size & size_mask;
+	unsigned short _cmd = 0;
+
+	_cmd = (size_bits << IPC_NB_OPCODE) + opcode_bits;
+
+	if (get_par(phydev) == 0)
+		_cmd &= ~IPC_CMD_PARITY;
+	else
+		_cmd |= IPC_CMD_PARITY;
+
+	*cmd = _cmd;
+	priv->ipc_cmd_num++;
+}
+
+static void aeon_mdio_write_reg(struct phy_device *phydev, unsigned int reg_addr, unsigned short value)
+{
+	unsigned short dev_addr = (reg_addr >> 17) & 0x1F;
+	unsigned short phy_reg = (reg_addr >> 1) & 0xFFFF;
+
+	phy_write_mmd(phydev, dev_addr, phy_reg, value);
+}
+
+static void aeon_set_ipc_data_reg(struct phy_device *phydev, unsigned int len, unsigned short *val)
+{
+	int ii;
+
+	if (len >= 8)
+		len = 8;
+
+	for (ii = 0; ii < len; ii++)
+		aeon_mdio_write_reg(phydev, IPC_DATA0_BASEADDR + 2 * ii, *(val + ii));
+}
+
+static void aeon_send_ipc_cmd(struct phy_device *phydev, unsigned short cmd)
+{
+	aeon_mdio_write_reg(phydev, IPC_CMD_BASEADDR, cmd);
+}
+
+static unsigned short aeon_mdio_read_reg(struct phy_device *phydev, unsigned int reg_addr)
+{
+	unsigned short val = 0;
+	unsigned short dev_addr = (reg_addr >> 17) & 0x1F;
+	unsigned short phy_reg = (reg_addr >> 1) & 0xFFFF;
+
+	val = aeon_cl45_read(phydev, dev_addr, phy_reg);
+	return val;
+}
+
+static unsigned short aeon_get_ipc_status(struct phy_device *phydev)
+{
+	unsigned short val;
+
+	val = aeon_mdio_read_reg(phydev, IPC_STS_BASEADDR);
+
+	return val;
+}
+
+static void aeon_ipc_parse_sts(unsigned short sts, unsigned short *status,
+			       unsigned short *opcode, unsigned short *size,
+			       unsigned short *parity)
+{
+	/*
+	 * """Parse the 16-bit full status into components.
+	 * 16-bit status register is laid out as follows:
+	 * [1 parity][5 size][6 opcode][4 status]
+	 */
+	unsigned short status_mask = (1 << IPC_NB_STATUS) - 1;
+	unsigned short opcode_mask = (1 << IPC_NB_OPCODE) - 1;
+	unsigned short size_mask = (1 << IPC_PAYLOAD_NB) - 1;
+
+	/* Clip off status bits */
+	*status = sts & status_mask;
+	sts = (sts >> IPC_NB_STATUS);
+
+	/* Clip off opcode */
+	*opcode = (sts & opcode_mask);
+	sts = (sts >> IPC_NB_OPCODE);
+
+	/* Clip off size */
+	*size = (sts & size_mask);
+	sts = (sts >> IPC_PAYLOAD_NB);
+
+	/* Get parity bit */
+	*parity = sts & 1;
+}
+
+static unsigned short aeon_ipc_wait_cmd_done(struct phy_device *phydev, unsigned long *ns, unsigned short *ret_size)
+{
+	/*
+	 * """Wait until IPC status handshake returns DONE or READY.
+	 * timeout : seconds
+	 * Returns
+	 * -------
+	 *  status : int
+	 *  Return status:
+	 *  opcode : int
+	 *  serviced.
+	 *  ret_size : int
+	 *  Number of bytes in the return.
+	 */
+	struct timespec64 t1, t2;
+	unsigned long _to, _ns = 0;
+	unsigned short sts, opcode, ret_par;
+	unsigned short status = 0, par = 0;
+
+	if (ns)
+		_to = *ns;
+	else
+		_to = IPC_TIMEOUT;
+
+	ktime_get_real_ts64(&t1);
+	while ((par == 0) || ((status != IPC_STS_CMD_SUCCESS)
+						&& (status != IPC_STS_CMD_ERROR))) {
+
+		mdelay(10);
+		sts = aeon_get_ipc_status(phydev);
+		aeon_ipc_parse_sts(sts, &status, &opcode, ret_size, &ret_par);
+		par = (get_par(phydev) != ret_par);
+
+		/* Check return status */
+		if (status == IPC_STS_CMD_ERROR)
+			break;
+
+		/* Check timeout */
+		ktime_get_real_ts64(&t2);
+		_ns = (t2.tv_sec - t1.tv_sec) * 1000000000 + t2.tv_nsec - t1.tv_nsec;
+		if (_ns > _to)
+			break;
+	}
+
+	return status;
+}
+
+static void aeon_ipc_cfg_param_direct(unsigned int data_len, unsigned short *data,
+				      struct phy_device *phydev)
+{
+	unsigned short cmd, status, ret_size;
+	struct device *dev = phydev_dev(phydev);
+	unsigned short buf[8] = {0};
+
+	buf[0] = IPC_CMD_CFG_DIRECT;
+	if (data_len >= 7)
+		data_len = 7;
+	memcpy(&buf[1], data, data_len * 2);
+	aeon_set_ipc_data_reg(phydev, data_len + 1, buf);
+	aeon_ipc_build_cmd(phydev, &cmd, IPC_CMD_CFG_PARAM, 2 * (data_len + 1));
+	aeon_send_ipc_cmd(phydev, cmd);
+
+	status = aeon_ipc_wait_cmd_done(phydev, NULL, &ret_size);
+	if (status != IPC_STS_CMD_SUCCESS) {
+		dev_err(dev, "IPC cfg param direct return status: %x\n",
+			status);
+		return;
+	}
+}
+
+static void aeon_receive_ipc_data(struct phy_device *phydev, unsigned short len,
+				  unsigned short *data)
+{
+	int ii;
+
+	if (len > 8)
+		len = 8;
+	for (ii = 0; ii < len; ii++) {
+		*(data + ii) = aeon_mdio_read_reg(phydev, IPC_DATA0_BASEADDR +
+								  (ii << 1));
+	}
+}
+
+static void aeon_cu_an_get_ms_cfg(unsigned short *ms_related_cfg,
+				  struct phy_device *phydev)
+{
+	unsigned short data[2] = {0}, reg_num = 2;
+
+	data[0] = CFG_CU_AN;
+	data[1] = IPC_CMD_CU_AN_GET_MS_CFG;
+
+	aeon_ipc_cfg_param_direct(reg_num, data, phydev);
+	aeon_receive_ipc_data(phydev, 3, (unsigned short *)ms_related_cfg);
+}
+
+static void aeon_cu_an_set_top_spd(unsigned short top_spd, struct phy_device *phydev)
+{
+	unsigned short data[3] = {0}, reg_num = 3;
+
+	data[0] = CFG_CU_AN;
+	data[1] = IPC_CMD_CU_AN_TOP_SPD;
+	data[2] = top_spd;
+
+	aeon_ipc_cfg_param_direct(reg_num, data, phydev);
+}
+
+static void aeon_cu_an_restart(struct phy_device *phydev)
+{
+	unsigned short data[2] = {0}, reg_num = 2;
+
+	data[0] = CFG_CU_AN;
+	data[1] = MDI_CFG_CU_AN_RESTART;
+
+	aeon_ipc_cfg_param_direct(reg_num, data, phydev);
+}
+
+static void aeon_ipc_sync_parity_private(struct phy_device *phydev)
+{
+	unsigned long noop_to = 20;
+	struct timespec64 t1, t2;
+	unsigned long _to = IPC_TIMEOUT, _ns = 0;
+	unsigned short cmd, par = 0;
+	unsigned short sts, status, opcode, size, ret_par;
+	struct device *dev = phydev_dev(phydev);
+
+	/* Send first noop, no need to wait reply */
+	aeon_ipc_build_cmd(phydev, &cmd, IPC_CMD_NOOP, 0);
+	aeon_send_ipc_cmd(phydev, cmd);
+	mdelay(noop_to);
+
+	/* Send second noop, expect the correct parity to return */
+	aeon_ipc_build_cmd(phydev, &cmd, IPC_CMD_NOOP, 0);
+	aeon_send_ipc_cmd(phydev, cmd);
+	par = 0;
+	ktime_get_real_ts64(&t1);
+	while (par == 0) {
+		mdelay(10);
+		sts = aeon_get_ipc_status(phydev);
+		aeon_ipc_parse_sts(sts, &status, &opcode, &size, &ret_par);
+		par = (get_par(phydev) != ret_par);
+
+		/* Check timeout */
+		ktime_get_real_ts64(&t2);
+		_ns = (t2.tv_sec - t1.tv_sec) * 1000000000 + t2.tv_nsec - t1.tv_nsec;
+		if (_ns > _to)
+			break;
+	}
+
+	if (par == 0)
+		dev_err(dev, "IPC sync failure: NOOP 3, sts: %x\n", aeon_get_ipc_status(phydev));
+}
+
+static void as2xxxx_apply_priv_data_config(struct phy_device *phydev)
+{
+	unsigned short ms_related_cfg[4] = {0};
+
+	/* Get current master/slave config (if needed for your hardware) */
+	if (!phydev) {
+		pr_err("%s: an883x_dev is NULL!\n", __func__);
+		return;
+	}
+	aeon_cu_an_get_ms_cfg(ms_related_cfg, phydev);
+	 /* Only set top speed if configured */
+		if (__priv_data.top_spd != 0xF)
+			aeon_cu_an_set_top_spd(__priv_data.top_spd, phydev);
+
+		/* Sync parity (if required by your hardware) */
+		aeon_ipc_sync_parity_private(phydev);
+		/* Restart autonegotiation */
+		aeon_cu_an_restart(phydev);
+		pr_info("AN-related CFG finish, restart AN successfully!\n");
+}
+
+static int as2xxxx_c45_check_and_restart_aneg(struct phy_device *phydev, bool restart)
+{
+	int ret = 0;
+
+	if (!restart) {
+		/* Configure and restart aneg if it wasn't set before */
+		ret = aeon_cl45_read(phydev, MDIO_MMD_AN, MDIO_CTRL1);
+		if (ret < 0)
+			return ret;
+
+		if (!(ret & MDIO_AN_CTRL1_ENABLE))
+			restart = true;
+	}
+
+	if (restart) {
+		as2xxxx_apply_priv_data_config(phydev);
+		ret = as2xxxx_c45_restart_aneg(phydev);
+	}
+
+	return ret;
+}
+
+static int get_speed_from_ethtool(struct phy_device *phydev)
+{
+	unsigned long advertising = *(phydev->advertising);
+
+	pr_info("phydev->advertising = 0x%lx\n", advertising);
+
+	if (advertising & ADVERTISED_10000baseT_Full) {
+		__priv_data.top_spd = MDI_CFG_SPD_T10G;
+		pr_info("Detected 10Gbps advertising\n");
+	} else if ((advertising & (1ULL<<33)) || ((advertising>>32) & (1ULL<<16))) {
+		__priv_data.top_spd = MDI_CFG_SPD_T5G;
+		 pr_info("Detected 5Gbps advertising\n");
+	} else if ((advertising & ADVERTISED_2500baseX_Full) || ((advertising>>32) & ADVERTISED_2500baseX_Full)) {
+		__priv_data.top_spd = MDI_CFG_SPD_T2P5G;
+		pr_info("Detected 2.5Gbps advertising\n");
+	} else if (advertising & ADVERTISED_1000baseT_Full) {
+		__priv_data.top_spd = MDI_CFG_SPD_T1G;
+		pr_info("Detected 1Gbps advertising\n");
+	} else if (advertising & ADVERTISED_100baseT_Full) {
+		__priv_data.top_spd = MDI_CFG_SPD_T100;
+		pr_info("Detected 100Mbps advertising\n");
+	} else if ((advertising & ADVERTISED_10baseT_Full) || (advertising == 0x62c0)) {
+		__priv_data.top_spd = MDI_CFG_SPD_T10;
+		pr_info("Detected 10Mbps advertising\n");
+	} else {
+		pr_info("Unknown speed advertised, defaulting to 100Mbps\n");
+		__priv_data.top_spd = MDI_CFG_SPD_T100;
+	}
+	return 1;
+}
+
+static int aeon_config_aneg(struct phy_device *phydev)
+{
+	bool changed = false;
+	int ret = 0;
+
+	if (phydev->autoneg == AUTONEG_DISABLE)
+		return as2xxxx_c45_pma_setup_forced(phydev);
+
+	ret = get_speed_from_ethtool(phydev);
+	if (ret < 0)
+		return ret;
+	if (ret > 0)
+		changed = true;
+
+	return as2xxxx_c45_check_and_restart_aneg(phydev, changed);
+}
+
+static int as2xxxx_read_abilities(struct phy_device *phydev)
+{
+	int val;
+
+	linkmode_set_bit_array(phy_basic_ports_array,
+			       ARRAY_SIZE(phy_basic_ports_array),
+			       phydev->supported);
+
+	val = aeon_cl45_read(phydev, 0x7, 0xffe1);
+	if (val < 0)
+		return val;
+
+	linkmode_mod_bit(ETHTOOL_LINK_MODE_Autoneg_BIT, phydev->supported,
+			val & BMSR_ANEGCAPABLE);
+
+	linkmode_mod_bit(ETHTOOL_LINK_MODE_100baseT_Full_BIT, phydev->supported,
+			val & BMSR_100FULL);
+	linkmode_mod_bit(ETHTOOL_LINK_MODE_100baseT_Half_BIT, phydev->supported,
+			val & BMSR_100HALF);
+	linkmode_mod_bit(ETHTOOL_LINK_MODE_10baseT_Full_BIT, phydev->supported,
+			val & BMSR_10FULL);
+	linkmode_mod_bit(ETHTOOL_LINK_MODE_10baseT_Half_BIT, phydev->supported,
+			val & BMSR_10HALF);
+
+	if (val & BMSR_ESTATEN) {
+		val = aeon_cl45_read(phydev, 0x7, 0xffef);
+		if (val < 0)
+			return val;
+
+		linkmode_mod_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT,
+				 phydev->supported, val & ESTATUS_1000_TFULL);
+		linkmode_mod_bit(ETHTOOL_LINK_MODE_1000baseT_Half_BIT,
+				 phydev->supported, val & ESTATUS_1000_THALF);
+		linkmode_mod_bit(ETHTOOL_LINK_MODE_1000baseX_Full_BIT,
+				 phydev->supported, val & ESTATUS_1000_XFULL);
+	}
+
+	/* This is optional functionality. If not supported, we may get an error
+	 * which should be ignored.
+	 */
+	/* genphy_c45_read_eee_abilities(phydev); */
+
+	return 0;
+}
+
+static int aeon_wait_reset_complete(struct phy_device *phydev)
+{
+	int val;
+
+	return read_poll_timeout(aeon_ipc_get_fw_version, val,
+				 val == 0, 10000, 2000000, false, phydev);
+}
+
+static int aeon_config_init(struct phy_device *phydev)
+{
+	int ret = aeon_wait_reset_complete(phydev);
+	int cnt = 0;
+	struct as2xxxx_priv *priv = phydev->priv;
+
+	if (!priv)
+		return -ENODEV;
+
+	if (ret) {
+		do {
+			if (phydev->phy_id == PHY_ID_AS21XXX_AN8831)
+				phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_PTP_CLK, 0x48);
+
+			ret = aeon_firmware_load(phydev);
+			/* Sync parity */
+			if (ret == 0) {
+				ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+				if (ret == 0) {
+					pr_info("as2xxxx(AN883x) Load Firmware Succ\n");
+					break;
+				}
+			}
+			cnt++;
+			phy_device_reset(phydev, 1);
+			usleep_range(5000, 6000);
+			phy_device_reset(phydev, 0);
+			usleep_range(5000, 6000);
+			pr_info("as2xxxx(AN883x) Load Firmware Again!!\n");
+		} while (cnt < FW_LOAD_TRY_NUM);
+		if (ret) {
+			phydev_err(phydev, "Firmware load failed\n");
+			return ret;
+		}
+		ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+		if (ret) {
+			phydev_err(phydev, "IPC sync parity failed\n");
+			return ret;
+		}
+		if (phydev->phy_id == PHY_ID_AS21XXX_AN8831) {
+			aeon_phy_set_bits_mmd(phydev, MDIO_MMD_VEND1, VEND1_PTP_CLK, VEND1_PTP_CLK_EN);
+			as21xxx_set_fast_mdc_timing(phydev);
+		} else if (phydev->phy_id == PHY_ID_AS22XXX_AN8833) {
+			as22xxx_set_trd_swap(phydev);
+		}
+
+		aeon_config_led(phydev);
+		ret = aeon_dpc_ra_enable(phydev);
+		if (ret) {
+			phydev_err(phydev, "Enable as2xxxx(AN883x) USXGMII failed\n");
+			return ret;
+		}
+
+		if (phydev->phy_id == PHY_ID_AS22XXX_AN8833) {
+			ret = as2xxxx_restart_dpc_fsm(phydev);
+			if (ret)
+				return ret;
+		}
+	} else {
+		phydev_info(phydev, "Firmware has been loaded!!!\n");
+	}
+
+	return 0;
+}
+
+static int aeon_get_features(struct phy_device *phydev)
+{
+	int ret;
+
+	ret = as2xxxx_read_abilities(phydev);
+	if (ret)
+		return ret;
+
+	/* AS2xxxx supports 100M/1G/2.5G/5G/10G speed. */
+	linkmode_clear_bit(ETHTOOL_LINK_MODE_10baseT_Half_BIT,
+			   phydev->supported);
+	linkmode_clear_bit(ETHTOOL_LINK_MODE_10baseT_Full_BIT,
+			   phydev->supported);
+	linkmode_clear_bit(ETHTOOL_LINK_MODE_100baseT_Half_BIT,
+			   phydev->supported);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_100baseT_Full_BIT,
+			   phydev->supported);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT,
+			phydev->supported);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_2500baseT_Full_BIT,
+			phydev->supported);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_5000baseT_Full_BIT,
+			phydev->supported);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_10000baseT_Full_BIT,
+			phydev->supported);
+
+	return 0;
+}
+
+static int as21xxx_read_mmd(struct phy_device *phydev, int devad,
+				u16 regnum)
+{
+	struct mii_bus *bus = phydev->mdio.bus;
+	int val;
+
+	val = __mdiobus_c45_read(bus, phydev->mdio.addr, devad,
+				 regnum);
+
+	/* FIXME: verify if it's actually ok to limit this to MII_BMSR */
+	__mdiobus_write(bus, 0x0, MII_BMSR, 0x1);
+
+	return val;
+}
+
+static int aeon_ipc_dpc_ra_set(struct phy_device *phydev, bool enable, u8 speed)
+{
+	u16 data[3], ra_enable[1] = {0};
+	u16 dbg_cmd;
+	int ret;
+
+	ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+	if (ret < 0)
+		return ret;
+
+	if (phydev->phy_id == PHY_ID_AS21XXX_AN8831) {
+		dbg_cmd = IPC_DPC_RA_SET_CFG;
+		ra_enable[0] = (u16)enable;
+	} else if (phydev->phy_id == PHY_ID_AS22XXX_AN8833) {
+		dbg_cmd = IPC_DPC_SDS_SET_CFG;
+		ra_enable[0] = ((u16)speed << 8) | (u16)enable;
+	} else {
+		return -EINVAL;
+	}
+
+	data[0] = (IPC_DBGCMD_DPC << 8) | dbg_cmd;
+	data[1] = 2;
+	data[2] = 0;
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_CFG_DBGCMD, data, ARRAY_SIZE(data), NULL, 0);
+	if (ret < 0)
+		return ret;
+
+	ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+	if (ret < 0)
+		return ret;
+
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_CFG_WBUF, ra_enable, ARRAY_SIZE(ra_enable), NULL, 0);
+	if (ret < 0)
+		return ret;
+
+	ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+	if (ret < 0)
+		return ret;
+
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_CFG_POLL, NULL, 0, NULL, 0);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+static int aeon_ipc_dpc_ra_get(struct phy_device *phydev, bool *enabled, u8 *speed)
+{
+	u16 data[3];
+	u16 dbg_cmd;
+	u16 ret_data[AEON_IPC_DATA_NUM_REGISTERS] = {0};
+	int ret;
+
+	ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+	if (ret < 0)
+		return ret;
+
+	if (phydev->phy_id == PHY_ID_AS21XXX_AN8831)
+		dbg_cmd = IPC_DPC_RA_GET_CFG;
+	else if (phydev->phy_id == PHY_ID_AS22XXX_AN8833)
+		dbg_cmd = IPC_DPC_SDS_GET_CFG;
+	else
+		return -EINVAL;
+
+	data[0] = (IPC_DBGCMD_DPC << 8) | dbg_cmd;
+	data[1] = 0;
+	data[2] = 0;
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_CFG_DBGCMD, data, ARRAY_SIZE(data), NULL, 0);
+	if (ret < 0)
+		return ret;
+
+	ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+	if (ret < 0)
+		return ret;
+
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_CFG_POLL, NULL, 0, NULL, 0);
+	if (ret < 0)
+		return ret;
+
+	ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+	if (ret < 0)
+		return ret;
+
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_CFG_RBUF, NULL, 0, ret_data, AEON_IPC_DATA_NUM_REGISTERS);
+	if (ret < 0)
+		return ret;
+
+	if (enabled != NULL)
+		*enabled = !!(ret_data[0] & 0xff);
+
+	if (phydev->phy_id == PHY_ID_AS22XXX_AN8833 && speed != NULL)
+		*speed = ret_data[0] >> 8;
+
+	return 0;
+}
+
+static unsigned int aeon_inband_caps(struct phy_device *phydev,
+					phy_interface_t interface)
+{
+	return LINK_INBAND_ENABLE | LINK_INBAND_DISABLE;
+
+}
+
+static int aeon_config_inband(struct phy_device *phydev,
+				 unsigned int modes)
+{
+	bool enabled = false;
+	u8 speed = 0;
+	int ret = 0;
+	bool en = (modes == LINK_INBAND_ENABLE);
+
+	ret = aeon_ipc_dpc_ra_get(phydev, &enabled, &speed);
+	if (ret < 0)
+		return ret;
+
+	/* Ignore if already in the desired mode */
+	if ((modes == LINK_INBAND_ENABLE && enabled) ||
+		(modes == LINK_INBAND_DISABLE && !enabled))
+		return 0;
+
+	if (phydev->phy_id == PHY_ID_AS21XXX_AN8831) {
+		/* no care speed*/
+		ret = aeon_ipc_dpc_ra_set(phydev, en, 0);
+	} else if (phydev->phy_id == PHY_ID_AS22XXX_AN8833) {
+		ret = aeon_ipc_dpc_ra_set(phydev, en, speed);
+	} else {
+		return -EINVAL;
+	}
+
+	return ret < 0 ? ret : 0;
+}
