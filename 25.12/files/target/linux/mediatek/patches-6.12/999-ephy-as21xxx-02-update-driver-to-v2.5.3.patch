+int aeon_cl45_read(struct phy_device *phydev, int dev_addr,
+		   unsigned int phy_reg)
+{
+	int data;
+
+	data = phy_read_mmd(phydev, dev_addr, phy_reg);
+	/*as21xxx patch start*/
+	if (phydev->phy_id == PHY_ID_AS21XXX_AN8831)
+		as21xxx_mdio_patch(phydev);
+	/*as21xxx patch end*/
+
+	return data;
+}
+
+void aeon_cl45_write(struct phy_device *phydev, int dev_addr,
+		    unsigned int phy_reg, unsigned short val)
+{
+	phy_write_mmd(phydev, dev_addr, phy_reg, val);
+}
+
+static int aeon_phy_modify_mmd(struct phy_device *phydev, int devad, u32 regnum, u16 mask, u16 set)
+{
+	int ret = 0;
+	u16 val = 0;
+
+	ret = aeon_cl45_read(phydev, devad, regnum);
+	val = (u16)ret;
+	val = (val & ~mask) | set;
+	ret = phy_write_mmd(phydev, devad, regnum, val);
+
+	return ret < 0 ? ret : 0;
+}
+
+static int aeon_phy_set_bits_mmd(struct phy_device *phydev, int devad, u32 regnum, u16 value)
+{
+	int ret = 0;
+	u16 val = 0;
+
+	ret = aeon_cl45_read(phydev, devad, regnum);
+	if (ret < 0)
+		return ret;
+
+	val = (u16)ret;
+	val |= value;
+	ret = phy_write_mmd(phydev, devad, regnum, val);
+
+	return ret < 0 ? ret : 0;
+}
+
+static int aeon_phy_clear_bits_mmd(struct phy_device *phydev, int devad,
+				   u32 regnum, u16 value)
+{
+	int ret = 0;
+	u16 val = 0;
+
+	ret = aeon_cl45_read(phydev, devad, regnum);
+	val = (u16)ret;
+	val = (val & ~value) | 0;
+	ret = phy_write_mmd(phydev, devad, regnum, val);
+
+	return ret < 0 ? ret : 0;
+}
