+#ifdef AEON_FW_VERIFY_SUPPORT
+static int aeon_firmware_read(struct phy_device *phydev, u32 start_addr, size_t size, u8 *buf)
+{
+	int ret, i, cnt = 0, val;
+	size_t full_u16 = size / 2;
+	size_t tail_byte = size % 2;
+
+	if (!buf || size == 0) {
+		phydev_err(phydev, "firmware data buffer invalid!\n");
+		return -EINVAL;
+	}
+
+	ret = aeon_phy_modify_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_CPU_CTRL,
+				 VEND1_GLB_CPU_CTRL_MASK, AEON_CPU_CTRL_FW_LOAD);
+	if (ret)
+		return ret;
+
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_FW_START_ADDR,
+				start_addr);
+	if (ret)
+		return ret;
+
+	/* READ_AUTO_INCR */
+	ret = aeon_phy_modify_mmd(phydev, MDIO_MMD_VEND1,
+				 VEND1_GLB_REG_MDIO_INDIRECT_ADDRCMD,
+				 0xfffc, 0x4000);
+	if (ret)
+		return ret;
+
+	while (cnt < AEON_BUSY_MAX_RETRY_CNT) {
+		val = aeon_cl45_read(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_MDIO_INDIRECT_ADDRCMD);
+		if (val < 0) {
+			phydev_err(phydev, "Read indirect addrcmd register failed, ret=%d\n", val);
+			return val;
+		}
+
+		if (!(val & AEON_INDIRECT_BUSY_BIT))
+			break;
+
+		phydev_err(phydev, "MDIO indirect busy, status=0x%04x, retry %d/%d\n",
+			   val, cnt + 1, AEON_BUSY_MAX_RETRY_CNT);
+		usleep_range(1000, 2000);
+		cnt++;
+	}
+
+	if (cnt >= AEON_BUSY_MAX_RETRY_CNT) {
+		phydev_err(phydev, "MDIO indirect wait timeout after %d retries\n",
+			   AEON_BUSY_MAX_RETRY_CNT);
+		return -EINVAL;
+	}
+
+	/* Firmware is always aligned to u16 */
+	for (i = 0; i < full_u16 * 2; i += 2) {
+		val = aeon_cl45_read(phydev, MDIO_MMD_VEND1,
+					VEND1_GLB_REG_MDIO_INDIRECT_LOAD);
+		if (val < 0) {
+			phydev_err(phydev, "firmware data %d read err: %d\n", i, val);
+			return val;
+		}
+
+		buf[i]     = val & 0x00ff;
+		buf[i + 1] = (val >> 8) & 0x00ff;
+	}
+
+	/* Handle single trailing byte (odd length) */
+	if (tail_byte) {
+		val = aeon_cl45_read(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_MDIO_INDIRECT_LOAD);
+		if (val < 0) {
+			phydev_err(phydev, "firmware tail byte read err: %d\n", val);
+			return val;
+		}
+		buf[full_u16 * 2] = val & 0xff;
+	}
+
+	return 0;
+}
+
+static int aeon_verify_firmware_image(struct phy_device *phydev, const u8 *fw_data, size_t fw_size, u32 boot_base)
+{
+	int ret;
+	size_t i, mismatch_cnt = 0;
+	u8 *mem_read_buf;
+
+	/* Check input firmware buffer validity */
+	if (!fw_data || fw_size == 0) {
+		phydev_err(phydev, "firmware data buffer invalid!\n");
+		return -EINVAL;
+	}
+
+	/* Allocate buffer to store image data read from PHY internal memory */
+	mem_read_buf = kmalloc(fw_size, GFP_KERNEL);
+	if (!mem_read_buf)
+		return -ENOMEM;
+
+	/* Read full boot memory region from PHY via MDIO indirect access */
+	ret = aeon_firmware_read(phydev, boot_base, fw_size, mem_read_buf);
+	if (ret < 0) {
+		phydev_err(phydev, "read memory failed, ret=%d\n", ret);
+		kfree(mem_read_buf);
+		return ret;
+	}
+
+	/* Byte-by-byte comparison, identical to zip(f_data, mem_data) loop in Python */
+	for (i = 0; i < fw_size; i++) {
+		if (fw_data[i] != mem_read_buf[i])
+			mismatch_cnt++;
+	}
+
+	/* Print final verification result */
+	if (mismatch_cnt == 0) {
+		phydev_info(phydev, "CPU image verified successfully.\n");
+		ret = 0;
+	} else {
+		phydev_err(phydev, "CPU image verification failed, total mismatches: %zu\n", mismatch_cnt);
+		ret = -EIO;
+	}
+
+	kfree(mem_read_buf);
+	return ret;
+}
+#endif
+
+static int aeon_firmware_boot(struct phy_device *phydev, const u8 *data,
+			      size_t size)
+{
+	int i, ret;
+	u16 val;
+	size_t remain;
+	size_t full_u16_cnt = size / 2;
+	size_t tail_byte = size % 2;
+
+	ret = aeon_phy_modify_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_CPU_CTRL,
+				  VEND1_GLB_CPU_CTRL_MASK, AEON_CPU_CTRL_FW_LOAD);
+	if (ret)
+		return ret;
+
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_FW_START_ADDR,
+			    AEON_BOOT_ADDR);
+	if (ret)
+		return ret;
+
+	ret = aeon_phy_modify_mmd(phydev, MDIO_MMD_VEND1,
+				  VEND1_GLB_REG_MDIO_INDIRECT_ADDRCMD,
+				  0x3ffc, 0xc000);
+	if (ret)
+		return ret;
+
+	val = aeon_cl45_read(phydev, MDIO_MMD_VEND1,
+			     VEND1_GLB_REG_MDIO_INDIRECT_STATUS);
+	if (val > 1) {
+		phydev_err(phydev, "wrong origin mdio_indirect_status: %x\n", val);
+		return -EINVAL;
+	}
+
+	/* Firmware is always aligned to u16 */
+	for (i = 0; i < full_u16_cnt * 2; i += 2) {
+		val = data[i + 1] << 8 | data[i];
+
+		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1,
+				    VEND1_GLB_REG_MDIO_INDIRECT_LOAD, val);
+		if (ret)
+			return ret;
+	}
+
+	/* Handle single trailing byte (odd length), high byte fill 0 */
+	if (tail_byte) {
+		val = data[full_u16_cnt * 2];
+		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_MDIO_INDIRECT_LOAD, val);
+		if (ret < 0)
+			return ret;
+	}
+
+	/* Pad zero to complete 4-byte hardware word
+	 * Target memory is empty before firmware load, no original data to preserve
+	 */
+	remain = (size + tail_byte) % MEM_WORD_SIZE;
+	if (remain != 0) {
+		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1,
+				    VEND1_GLB_REG_MDIO_INDIRECT_LOAD, 0);
+		if (ret < 0) {
+			phydev_err(phydev, "Pad zero register write failed, ret=%d\n", ret);
+			return ret;
+		}
+	}
+
+#ifdef AEON_FW_VERIFY_SUPPORT
+	/* Verify written memory against original firmware buffer */
+	ret = aeon_verify_firmware_image(phydev, data, size, AEON_BOOT_ADDR);
+	if (ret < 0)
+		return -EIO; /* Mark mismatch as IO error for retry trigger */
+#endif
+
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND1,
+			    VEND1_GLB_REG_CPU_RESET_ADDR_LO_BASEADDR,
+			    lower_16_bits(AEON_CPU_BOOT_ADDR));
+	if (ret)
+		return ret;
+
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND1,
+			    VEND1_GLB_REG_CPU_RESET_ADDR_HI_BASEADDR,
+			    upper_16_bits(AEON_CPU_BOOT_ADDR));
+	if (ret)
+		return ret;
+
+	return aeon_phy_modify_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLB_REG_CPU_CTRL,
+				   VEND1_GLB_CPU_CTRL_MASK, AEON_CPU_CTRL_FW_START);
+}
+
+static int aeon_firmware_load(struct phy_device *phydev)
+{
+	struct device *dev = &phydev->mdio.dev;
+	const struct firmware *fw;
+	const char *fw_name;
+	int ret;
+
+	if (phydev->phy_id == PHY_ID_AS21XXX_AN8831)
+		fw_name = AS21XXX_FW_BIN;
+	else if (phydev->phy_id == PHY_ID_AS22XXX_AN8833)
+		fw_name = AS22XXX_FW_BIN;
+
+	ret = request_firmware(&fw, fw_name, dev);
+	if (ret) {
+		phydev_err(phydev, "failed to find FW file %s (%d)\n",
+			   fw_name, ret);
+		return ret;
+	}
+
+	ret = aeon_firmware_boot(phydev, fw->data, fw->size);
+
+	release_firmware(fw);
+
+	msleep(600);
+
+	return ret;
+}
+
+static bool aeon_ipc_ready(u16 val, bool parity_status)
+{
+	u16 status;
+
+	if (FIELD_GET(AEON_IPC_STS_PARITY, val) != parity_status)
+		return false;
+
+	status = val & AEON_IPC_STS_STATUS;
+
+	return status == AEON_IPC_STS_STATUS_SUCCESS;
+}
+
+static int aeon_ipc_wait_cmd(struct phy_device *phydev, bool parity_status)
+{
+	u16 val;
+
+	/* Exit condition logic:
+	 * - Wait for parity bit equal
+	 * - Wait for status success, error OR ready
+	 */
+	return read_poll_timeout(aeon_cl45_read, val, aeon_ipc_ready(val, parity_status), AEON_IPC_DELAY,
+				 AEON_IPC_TIMEOUT, false, phydev, MDIO_MMD_VEND1, VEND1_IPC_STS);
+}
+
+static int aeon_ipc_send_cmd(struct phy_device *phydev,
+			     struct as2xxxx_priv *priv,
+			     u16 cmd, u16 *ret_sts)
+{
+	bool curr_parity;
+	int ret;
+
+	/* The IPC sync by using a single parity bit.
+	 * Each CMD have alternately this bit set or clear
+	 * to understand correct flow and packet order.
+	 */
+	curr_parity = priv->parity_status;
+	if (priv->parity_status)
+		cmd |= AEON_IPC_CMD_PARITY;
+
+	/* Always update parity for next packet */
+	priv->parity_status = !priv->parity_status;
+
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_IPC_CMD, cmd);
+	if (ret)
+		return ret;
+
+	/* Wait for packet to be processed */
+	usleep_range(AEON_IPC_DELAY, AEON_IPC_DELAY + 5000);
+
+	/* With no ret_sts, ignore waiting for packet completion
+	 * (ipc parity bit sync)
+	 */
+	if (!ret_sts)
+		return 0;
+
+	ret = aeon_ipc_wait_cmd(phydev, curr_parity);
+	if (ret)
+		return ret;
+
+	ret = aeon_cl45_read(phydev, MDIO_MMD_VEND1, VEND1_IPC_STS);
+	if (ret < 0)
+		return ret;
+
+	*ret_sts = ret;
+	if ((*ret_sts & AEON_IPC_STS_STATUS) != AEON_IPC_STS_STATUS_SUCCESS)
+		return -EINVAL;
+
+	return 0;
+}
+
+/* If data is NULL, return 0 or negative error.
+ * If data not NULL, return number of Bytes received from IPC or
+ * a negative error.
+ */
+static int aeon_ipc_send_msg(struct phy_device *phydev,
+			     u16 opcode, u16 *data, unsigned int data_len,
+			     u16 *ret_data, unsigned int ret_data_len)
+{
+	struct as2xxxx_priv *priv = phydev->priv;
+	unsigned int ret_size, reg_cnt;
+	u16 cmd, ret_sts;
+	int ret;
+	int i;
+
+	if (!priv)
+		return -EINVAL;
+
+	mutex_lock(&priv->ipc_lock);
+
+	/* IPC have a max of 8 register to transfer data,
+	 * make sure we never exceed this.
+	 */
+	if (data_len > AEON_IPC_DATA_NUM_REGISTERS) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (data && data_len > 0) {
+		for (i = 0; i < data_len; i++)
+			phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_IPC_DATA(i),
+				      data[i]);
+	}
+
+	cmd = FIELD_PREP(AEON_IPC_CMD_SIZE, data_len * sizeof(unsigned short)) |
+	      FIELD_PREP(AEON_IPC_CMD_OPCODE, opcode);
+
+	ret = aeon_ipc_send_cmd(phydev, priv, cmd, &ret_sts);
+	if (ret) {
+		phydev_dbg(phydev, "failed to send ipc msg for %x: %d\n",
+			   opcode, ret);
+		goto out;
+	}
+
+	if (!ret_data)
+		goto out;
+
+	if ((ret_sts & AEON_IPC_STS_STATUS) == AEON_IPC_STS_STATUS_ERROR) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	/* Prevent IPC from stack smashing the kernel.
+	 * We can't trust IPC to return a good value and we always
+	 * preallocate space for 16 Bytes.
+	 */
+	ret_size = FIELD_GET(AEON_IPC_STS_SIZE, ret_sts);
+	if (ret_size > AEON_IPC_DATA_MAX) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	reg_cnt = DIV_ROUND_UP(ret_size, sizeof(u16));
+	if (reg_cnt > ret_data_len) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	/* Read data from IPC data register for ret_size value from IPC */
+	for (i = 0; i < reg_cnt; i++) {
+		ret = aeon_cl45_read(phydev, MDIO_MMD_VEND1, VEND1_IPC_DATA(i));
+		if (ret < 0)
+			goto out;
+
+		ret_data[i] = ret;
+	}
+
+	ret = ret_size;
+
+out:
+	mutex_unlock(&priv->ipc_lock);
+
+	return ret;
+}
+
+static int aeon_ipc_noop(struct phy_device *phydev,
+			 struct as2xxxx_priv *priv, u16 *ret_sts)
+{
+	u16 cmd;
+
+	cmd = FIELD_PREP(AEON_IPC_CMD_SIZE, 0) |
+	      FIELD_PREP(AEON_IPC_CMD_OPCODE, IPC_CMD_NOOP);
+
+	return aeon_ipc_send_cmd(phydev, priv, cmd, ret_sts);
+}
+
+/* Logic to sync parity bit with IPC.
+ * We send 2 NOP cmd with same partity and we wait for IPC
+ * to handle the packet only for the second one. This way
+ * we make sure we are sync for every next cmd.
+ */
+static int aeon_ipc_sync_parity(struct phy_device *phydev,
+				struct as2xxxx_priv *priv)
+{
+	u16 ret_sts = 0;
+	int ret = -EINVAL;
+	int cnt = 0;
+
+	do {
+		mutex_lock(&priv->ipc_lock);
+
+		/* Reset packet parity */
+		priv->parity_status = true;
+
+		/* Send NOP with no parity */
+		aeon_ipc_noop(phydev, priv, NULL);
+
+		/* Reset packet parity */
+		priv->parity_status = false;
+
+		/* Send second NOP with no parity */
+		ret = aeon_ipc_noop(phydev, priv, &ret_sts);
+
+		mutex_unlock(&priv->ipc_lock);
+
+		if (ret == 0)
+			break;
+
+		cnt++;
+		usleep_range(10000, 11000);
+	} while (cnt < 5);
+
+	/* We expect to return 0 */
+	if (ret != 0)
+		return ret;
+
+	if ((ret_sts & AEON_IPC_STS_STATUS) != AEON_IPC_STS_STATUS_SUCCESS) {
+		phydev_err(phydev, "Invalid IPC status on sync parity: %x\n",
+			   ret_sts);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int aeon_ipc_get_fw_version(struct phy_device *phydev)
+{
+	u16 ret_data[AEON_IPC_DATA_NUM_REGISTERS] = {0}, data[1];
+	char fw_version[AEON_IPC_DATA_MAX + 1] = {0};
+	int ret;
+
+	data[0] = IPC_INFO_VERSION;
+
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_INFO, data,
+				ARRAY_SIZE(data), ret_data, AEON_IPC_DATA_NUM_REGISTERS);
+	if (ret < 0)
+		return ret;
+
+	/* Make sure FW version is NULL terminated */
+	memcpy(fw_version, ret_data, ret);
+	fw_version[AEON_IPC_DATA_MAX] = '\0';
+
+	phydev_info(phydev, "Firmware Version: %s\n", fw_version);
+
+	return 0;
+}
+
+static int aeon_ipc_set_led_cfg(unsigned short led0, unsigned short led1,
+				unsigned short led2, unsigned short led3,
+				unsigned short led4, unsigned short polarity,
+				unsigned short blink, struct phy_device *phydev)
+{
+	u16 ret;
+	u16 cfg[7] = {
+		led0, led1, led2, led3, led4, polarity, blink
+	};
+
+	ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+	if (ret)
+		return ret;
+
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_SET_LED, cfg, ARRAY_SIZE(cfg), NULL, 0);
+
+	return ret < 0 ? ret : 0;
+}
+
+static int aeon_config_led(struct phy_device *phydev)
+{
+	aeon_ipc_set_led_cfg(custome_cfg[0], custome_cfg[1], custome_cfg[2],
+			     custome_cfg[3], custome_cfg[4],
+			     custome_cfg[5], custome_cfg[6], phydev);
+
+	return 0;
+}
+
+static int aeon_dpc_ra_enable(struct phy_device *phydev)
+{
+	u16 data[2];
+	int cnt = 0;
+	int ret = 0;
+
+	do {
+		data[0] = IPC_CFG_PARAM_DIRECT;
+		data[1] = IPC_CFG_PARAM_DIRECT_DPC_RA;
+		ret = aeon_ipc_send_msg(phydev, IPC_CMD_CFG_PARAM, data,
+					ARRAY_SIZE(data), NULL, 0);
+		if (ret == 0)
+			break;
+
+		cnt++;
+		usleep_range(10000, 11000);
+	} while (cnt < 5);
+
+	return ret;
+}
+
+static int as2xxxx_start_stop_dpc_fsm(struct phy_device *phydev, u16 enable)
+{
+	unsigned short data[3] = { 0 };
+
+	data[0] = IPC_CFG_PARAM_DIRECT;
+	data[1] = IPC_CFG_PARAM_DIRECT_DPC_FSM_START;
+	data[2] = enable;
+
+	return aeon_ipc_send_msg(phydev, IPC_CMD_CFG_PARAM,
+				 data, ARRAY_SIZE(data), NULL, 0);
+}
+
+static int as2xxxx_restart_dpc_fsm(struct phy_device *phydev)
+{
+	int ret = 0;
+
+	ret = as2xxxx_start_stop_dpc_fsm(phydev, IPC_CFG_PARAM_DIRECT_DPC_FSM_START_DISABLE);
+	if (ret < 0)
+		return ret;
+
+	mdelay(20);
+
+	ret = as2xxxx_start_stop_dpc_fsm(phydev, IPC_CFG_PARAM_DIRECT_DPC_FSM_START_ENABLE);
+	return ret;
+}
+
+static int aeon_restart_an(struct phy_device *phydev)
+{
+	u16 data[3] = {0};
+
+	data[0] = IPC_CFG_PARAM_DIRECT;
+	data[1] = IPC_CFG_PARAM_DIRECT_CU_AN;
+	data[2] = IPC_CFG_PARAM_DIRECT_CU_AN_RESTART;
+
+	return aeon_ipc_send_msg(phydev, IPC_CMD_CFG_PARAM, data,
+				 ARRAY_SIZE(data), NULL, 0);
+}
+
+static int as22xxx_ipc_set_trd_swap(struct phy_device *phydev, int enable, int value)
+{
+	u16 data[5] = {0};
+
+	data[0] = IPC_CFG_PARAM_DIRECT;
+	data[1] = IPC_CFG_PARAM_DIRECT_CU_AN;
+	data[2] = IPC_CFG_PARAM_DIRECT_CU_AN_TRD_SWAP;
+	data[3] = enable;
+	data[4] = value;
+
+	return aeon_ipc_send_msg(phydev, IPC_CMD_CFG_PARAM, data,
+				 ARRAY_SIZE(data), NULL, 0);
+}
+
+static int as22xxx_set_trd_swap(struct phy_device *phydev)
+{
+	struct device_node *np = phydev->mdio.dev.of_node;
+	u32 trd_swap_val;
+	int ret = 0;
+
+	if (of_property_read_u32(np, "trd-swap", &trd_swap_val) == 0) {
+		phydev_info(phydev, "set trd-swap from dts: %d\n", trd_swap_val);
+
+		ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+		if (ret)
+			return ret;
+		ret = as22xxx_ipc_set_trd_swap(phydev, 1, trd_swap_val & 1);
+		if (ret)
+			return ret;
+
+		ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+		if (ret)
+			return ret;
+		ret = aeon_restart_an(phydev);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int aeon_ipc_set_phy_enable_mode(unsigned short enable, struct phy_device *phydev)
+{
+	u16 cfg[2] = { IPC_SYS_CPU_PHY_ENABLE, enable };
+
+	return aeon_ipc_send_msg(phydev, IPC_CMD_SYS_CPU, cfg, 2, NULL, 0);
+}
+
+static int aeon_phy_suspend(struct phy_device *phydev)
+{
+	int ret = 0;
+
+	ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+	if (ret)
+		return ret;
+
+	return aeon_ipc_set_phy_enable_mode(0, phydev);
+}
+
+static int aeon_phy_resume(struct phy_device *phydev)
+{
+	int ret = 0;
+
+	ret = aeon_ipc_sync_parity(phydev, phydev->priv);
+	if (ret)
+		return ret;
+
+	return aeon_ipc_set_phy_enable_mode(1, phydev);
+}
+
+static int as21xxx_probe(struct phy_device *phydev)
+{
+	struct as2xxxx_priv *priv;
+	int ret;
+
+	priv = devm_kzalloc(&phydev->mdio.dev,
+			    sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	phydev->priv = priv;
+
+	ret = devm_mutex_init(&phydev->mdio.dev,
+			      &priv->ipc_lock);
+	if (ret)
+		return ret;
+
+	/* Even if PHY declare support for Clause 22 register,
+	 * Clause 45 register should be used for ANEG configuration
+	 * and restart. Clear the C22 bit for devices_in_package to
+	 * force C45 generic OPs in generic PHY ANGE OPs.
+	 */
+	phydev->c45_ids.devices_in_package &= ~BIT(0);
+
+	ret = aeon_ipc_sync_parity(phydev, priv);
+	if (ret)
+		return ret;
+
+	ret = aeon_ipc_get_fw_version(phydev);
+	if (ret)
+		return ret;
+
+	/* Enable PTP clk if not already Enabled */
+	ret = aeon_phy_set_bits_mmd(phydev, MDIO_MMD_VEND1, VEND1_PTP_CLK,
+				    VEND1_PTP_CLK_EN);
+	if (ret)
+		return ret;
+
+	aeon_config_led(phydev);
+	ret = aeon_dpc_ra_enable(phydev);
+
+	as2xxxx_debugfs_init(phydev);
+	pr_info("as21xxx debugfs init ok!\n");
+
+	return ret;
+}
+
+static int as22xxx_probe(struct phy_device *phydev)
+{
+	struct as2xxxx_priv *priv;
+	int ret;
+
+	priv = devm_kzalloc(&phydev->mdio.dev,
+			    sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	phydev->priv = priv;
+
+	ret = devm_mutex_init(&phydev->mdio.dev,
+			      &priv->ipc_lock);
+	if (ret)
+		return ret;
+
+	/* Even if PHY declare support for Clause 22 register,
+	 * Clause 45 register should be used for ANEG configuration
+	 * and restart. Clear the C22 bit for devices_in_package to
+	 * force C45 generic OPs in generic PHY ANGE OPs.
+	 */
+	phydev->c45_ids.devices_in_package &= ~BIT(0);
+
+	ret = aeon_ipc_sync_parity(phydev, priv);
+	if (ret)
+		return ret;
+
+	ret = aeon_ipc_get_fw_version(phydev);
+	if (ret)
+		return ret;
+
+	ret = as22xxx_set_trd_swap(phydev);
+	if (ret)
+		return ret;
+
+	aeon_config_led(phydev);
+
+	ret = aeon_dpc_ra_enable(phydev);
+	if (ret)
+		return ret;
+
+	ret = as2xxxx_restart_dpc_fsm(phydev);
+	if (ret)
+		return ret;
+
+	ret = as2xxxx_debugfs_init(phydev);
+	if (ret)
+		return ret;
+	pr_info("as22xxx debugfs init ok!\n");
+
+	return 0;
+}
+
+static void as2xxxx_remove(struct phy_device *phydev)
+{
+	as2xxxx_debugfs_remove(phydev);
+}
+
+static int as2xxxx_read_link(struct phy_device *phydev, int *bmcr)
+{
+	int status;
+	bool link_up;
+
+	/* Normal C22 BMCR report inconsistent data, use
+	 * the mapped C22 in C45 to have more consistent link info.
+	 */
+	*bmcr = aeon_cl45_read(phydev, MDIO_MMD_AN,
+			       AS2XXXX_MDIO_AN_C22 + MII_BMCR);
+	if (*bmcr < 0)
+		return *bmcr;
+
+	/* Autoneg is being started, therefore disregard current
+	 * link status and report link as down.
+	 */
+	if (*bmcr & BMCR_ANRESTART) {
+		phydev->link = 0;
+		return 0;
+	}
+
+	status = aeon_cl45_read(phydev, MDIO_MMD_AN, AN_STATES1_ADDR);
+	if (status < 0)
+		return status;
+
+	link_up = ((status & AN_STATES1_ARB_MASK) >> AN_STATES1_ARB_OFST) == LINK_GOOD;
+	phydev->link = link_up;
+	phydev->autoneg_complete = link_up;
+
+	/* Consider the case that autoneg was started and "aneg complete"
+	 * bit has been reset, but "link up" bit not yet.
+	 */
+	if (phydev->autoneg == AUTONEG_ENABLE && !phydev->autoneg_complete)
+		phydev->link = 0;
+
+	return 0;
+}
+
+static int as2xxxx_read_c22_lpa(struct phy_device *phydev)
+{
+	int lpagb, lpa;
+
+	/* MII_STAT1000 are only filled in the mapped C22
+	 * in C45, use that to fill lpagb values and check.
+	 */
+	lpagb = aeon_cl45_read(phydev, MDIO_MMD_AN,
+			       AS2XXXX_MDIO_AN_C22 + MII_STAT1000);
+	if (lpagb < 0)
+		return lpagb;
+
+	if (lpagb & LPA_1000MSFAIL) {
+		int adv = aeon_cl45_read(phydev, MDIO_MMD_AN,
+					 AS2XXXX_MDIO_AN_C22 + MII_CTRL1000);
+
+		if (adv < 0)
+			return adv;
+
+		if (adv & CTL1000_ENABLE_MASTER)
+			phydev_err(phydev, "Master/Slave resolution failed, maybe conflicting manual settings?\n");
+		else
+			phydev_err(phydev, "Master/Slave resolution failed\n");
+		return -ENOLINK;
+	}
+
+	mii_stat1000_mod_linkmode_lpa_t(phydev->lp_advertising,
+					lpagb);
+
+	lpa = aeon_cl45_read(phydev, MDIO_MMD_AN,
+			     AS2XXXX_MDIO_AN_C22 + MII_LPA);
+	if (lpa < 0)
+		return lpa;
+
+	mii_lpa_mod_linkmode_lpa_t(phydev->lp_advertising, lpa);
+
+	return 0;
+}
+
+static int aeon_read_status(struct phy_device *phydev)
+{
+	int bmcr, old_link = phydev->link;
+	int speed;
+	int ret;
+
+	ret = as2xxxx_read_link(phydev, &bmcr);
+	if (ret)
+		return ret;
+
+	/* why bother the PHY if nothing can have changed */
+	if (phydev->autoneg == AUTONEG_ENABLE && old_link && phydev->link)
+		return 0;
+
+	phydev->speed = SPEED_UNKNOWN;
+	phydev->duplex = DUPLEX_UNKNOWN;
+	phydev->pause = 0;
+	phydev->asym_pause = 0;
+
+	if (phydev->autoneg == AUTONEG_ENABLE) {
+		if (!phydev->autoneg_complete) {
+			mii_stat1000_mod_linkmode_lpa_t(phydev->lp_advertising,
+							0);
+			mii_lpa_mod_linkmode_lpa_t(phydev->lp_advertising, 0);
+			return 0;
+		}
+
+		ret = as2xxxx_read_c22_lpa(phydev);
+		if (ret)
+			return ret;
+	} else {
+		linkmode_zero(phydev->lp_advertising);
+	}
+
+	speed = aeon_cl45_read(phydev, MDIO_MMD_VEND1,
+			       VEND1_SPEED_STATUS);
+	if (speed < 0)
+		return speed;
+
+	switch (speed & VEND1_SPEED_MASK) {
+	case VEND1_SPEED_10000:
+		phydev->speed = SPEED_10000;
+		phydev->duplex = DUPLEX_FULL;
+		break;
+	case VEND1_SPEED_5000:
+		phydev->speed = SPEED_5000;
+		phydev->duplex = DUPLEX_FULL;
+		break;
+	case VEND1_SPEED_2500:
+		phydev->speed = SPEED_2500;
+		phydev->duplex = DUPLEX_FULL;
+		break;
+	case VEND1_SPEED_1000:
+		phydev->speed = SPEED_1000;
+		if (bmcr & BMCR_FULLDPLX)
+			phydev->duplex = DUPLEX_FULL;
+		else
+			phydev->duplex = DUPLEX_HALF;
+		break;
+	case VEND1_SPEED_100:
+		phydev->speed = SPEED_100;
+		phydev->duplex = DUPLEX_FULL;
+		break;
+	case VEND1_SPEED_10:
+		phydev->speed = SPEED_10;
+		phydev->duplex = DUPLEX_FULL;
+		break;
+	}
+
+	if (phydev->autoneg == AUTONEG_ENABLE)
+		phy_resolve_aneg_pause(phydev);
+
+	pr_info("AS2xxxx: Copper link status: link=%d, speed=%d, duplex=%d, autoneg=%d\n",
+	phydev->link, phydev->speed, phydev->duplex, phydev->autoneg);
+	return 0;
+}
