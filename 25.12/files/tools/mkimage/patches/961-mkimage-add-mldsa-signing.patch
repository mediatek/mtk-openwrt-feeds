+++ b/lib/mldsa/mldsa-libcrypto.c
@@ -0,0 +1,467 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2026 MediaTek Inc.
+ *
+ * ML-DSA (FIPS 204) image signing implementation using libcrypto backend
+ */
+
+#define OPENSSL_API_COMPAT 0x10101000L
+
+#include <openssl/opensslv.h>
+
+#if OPENSSL_VERSION_NUMBER < 0x30500000L
+#error "ML-DSA requires OpenSSL 3.5.0 or later"
+#endif
+
+#include <image.h>
+#include <u-boot/mldsa.h>
+
+#include <openssl/core_names.h>
+#include <openssl/evp.h>
+#include <openssl/params.h>
+#include <openssl/pem.h>
+#include <openssl/x509.h>
+
+#define MLDSA_ALG_NAME		"ML-DSA-87"
+
+static int mldsa_pem_get_privkey(const char *keydir, const char *name,
+				 EVP_PKEY **evpp)
+{
+	char path[1024] = { 0 };
+	EVP_PKEY *key = NULL;
+	FILE *f;
+	int len;
+
+	if (!keydir || !name)
+		return -EINVAL;
+
+	*evpp = NULL;
+	len = snprintf(path, sizeof(path), "%s/%s.key", keydir, name);
+	if (len < 0 || len >= sizeof(path))
+		return -EINVAL;
+
+	f = fopen(path, "r");
+	if (!f) {
+		fprintf(stderr, "Couldn't open ML-DSA private key: '%s': %s\n",
+			path, strerror(errno));
+		return -ENOENT;
+	}
+
+	if (!PEM_read_PrivateKey(f, &key, NULL, NULL)) {
+		fprintf(stderr, "Couldn't read private key: '%s'\n", path);
+		fclose(f);
+		return -EINVAL;
+	}
+
+	if (EVP_PKEY_is_a(key, MLDSA_ALG_NAME) != 1) {
+		fprintf(stderr, "Invalid private key for ML-DSA\n");
+		EVP_PKEY_free(key);
+		fclose(f);
+		return -EINVAL;
+	}
+
+	*evpp = key;
+	fclose(f);
+
+	return 0;
+}
+
+static int mldsa_pem_get_pubkey(const char *keydir, const char *name,
+				EVP_PKEY **evpp)
+{
+	char path[1024] = { 0 };
+	EVP_PKEY *key = NULL;
+	X509 *cert = NULL;
+	int ret = 0;
+	int len;
+	FILE *f;
+
+	if (!keydir || !name)
+		return -EINVAL;
+
+	*evpp = NULL;
+	len = snprintf(path, sizeof(path), "%s/%s.crt", keydir, name);
+	if (len < 0 || len >= sizeof(path))
+		return -EINVAL;
+
+	f = fopen(path, "r");
+	if (!f) {
+		fprintf(stderr, "Couldn't open ML-DSA certificate: '%s': %s\n",
+			path, strerror(errno));
+		return -ENOENT;
+	}
+
+	/* Read the certificate */
+	if (!PEM_read_X509(f, &cert, NULL, NULL)) {
+		fprintf(stderr, "Couldn't read certificate: '%s'\n", path);
+		fclose(f);
+		return -EINVAL;
+	}
+
+	/* Get the public key from the certificate. */
+	key = X509_get_pubkey(cert);
+	if (!key) {
+		fprintf(stderr, "Couldn't read public key\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (EVP_PKEY_is_a(key, MLDSA_ALG_NAME) != 1) {
+		fprintf(stderr, "Invalid public key for ML-DSA\n");
+		ret = -EINVAL;
+		EVP_PKEY_free(key);
+		goto out;
+	}
+
+	*evpp = key;
+
+out:
+	X509_free(cert);
+	fclose(f);
+
+	return ret;
+}
+
+static int fdt_get_pubkey(const void *fdt, int node, int expected_len,
+			  const uint8_t **pkp, int *lenp)
+{
+	const uint8_t *pk;
+
+	if (!fdt)
+		return -EINVAL;
+
+	pk = fdt_getprop(fdt, node, "mldsa,pubkey", lenp);
+	if (!pk) {
+		fprintf(stderr, "No 'mldsa,pubkey' in node %d\n", node);
+		return -ENOENT;
+	}
+
+	if (*lenp != expected_len) {
+		fprintf(stderr, "Bad public key length %d (expected %d)\n",
+			*lenp, expected_len);
+		return -EINVAL;
+	}
+
+	*pkp = pk;
+
+	return 0;
+}
+
+static int mldsa_fdt_get_pubkey(const struct image_sign_info *info,
+				const uint8_t **pkp, int *lenp)
+{
+	const void *fdt = info->fdt_blob;
+	int sig_node, key_node;
+	int expected_len;
+
+	if (!fdt || !info->crypto)
+		return -EINVAL;
+
+	expected_len = info->crypto->key_len;
+
+	if (info->required_keynode >= 0)
+		return fdt_get_pubkey(fdt, info->required_keynode, expected_len, pkp, lenp);
+
+	sig_node = fdt_subnode_offset(fdt, 0, FIT_SIG_NODENAME);
+	if (sig_node < 0)
+		return -ENOENT;
+
+	if (info->keyname) {
+		key_node = fdt_subnode_offset(fdt, sig_node, info->keyname);
+		if (key_node >= 0)
+			return fdt_get_pubkey(fdt, key_node, expected_len, pkp, lenp);
+	}
+
+	fdt_for_each_subnode(key_node, fdt, sig_node) {
+		if (!fdt_get_pubkey(fdt, key_node, expected_len, pkp, lenp))
+			return 0;
+	}
+
+	return -ENOENT;
+}
+
+static int load_pubkey_from_raw(const uint8_t *pk, int pk_len, EVP_PKEY **evpp)
+{
+	OSSL_PARAM params[2] = { 0 };
+	EVP_PKEY *key = NULL;
+	EVP_PKEY_CTX *ctx;
+	int ret = 0;
+
+	*evpp = NULL;
+
+	ctx = EVP_PKEY_CTX_new_from_name(NULL, MLDSA_ALG_NAME, NULL);
+	if (!ctx)
+		return -EINVAL;
+
+	params[0] = OSSL_PARAM_construct_octet_string(OSSL_PKEY_PARAM_PUB_KEY,
+						      (void *)pk, pk_len);
+	params[1] = OSSL_PARAM_construct_end();
+
+	if (EVP_PKEY_fromdata_init(ctx) != 1) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (EVP_PKEY_fromdata(ctx, &key, EVP_PKEY_PUBLIC_KEY, params) != 1) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	*evpp = key;
+
+out:
+	EVP_PKEY_CTX_free(ctx);
+
+	return ret;
+}
+
+static int mldsa_get_pubkey_from_fdt(const struct image_sign_info *info,
+				     EVP_PKEY **evpp)
+{
+	const uint8_t *pk = NULL;
+	int pk_len = 0;
+	int ret;
+
+	ret = mldsa_fdt_get_pubkey(info, &pk, &pk_len);
+	if (ret)
+		return ret;
+
+	return load_pubkey_from_raw(pk, pk_len, evpp);
+}
+
+static int mldsa_get_message(const struct image_region region[],
+			     int region_count, uint8_t **msgp, size_t *lenp)
+{
+	size_t total = 0;
+	uint8_t *buf, *p;
+	int i;
+
+	for (i = 0; i < region_count; i++) {
+		if (!region[i].data || region[i].size <= 0 ||
+		    total > ULONG_MAX - region[i].size)
+			return -EINVAL;
+		total += region[i].size;
+	}
+
+	if (!total)
+		return -EINVAL;
+
+	buf = malloc(total);
+	if (!buf)
+		return -ENOMEM;
+
+	for (i = 0, p = buf; i < region_count; i++) {
+		memcpy(p, region[i].data, region[i].size);
+		p += region[i].size;
+	}
+
+	*msgp = buf;
+	*lenp = total;
+
+	return 0;
+}
+
+static int mldsa_sign_with_key(EVP_PKEY *pkey,
+			       const struct image_region region[],
+			       int region_count, uint8_t **sigp, uint *sig_len)
+{
+	uint8_t *msg = NULL, *sig = NULL;
+	size_t msg_len = 0, slen = 0;
+	EVP_MD_CTX *mctx;
+	int ret;
+
+	ret = mldsa_get_message(region, region_count, &msg, &msg_len);
+	if (ret)
+		return ret;
+
+	mctx = EVP_MD_CTX_new();
+	if (!mctx) {
+		free(msg);
+		return -ENOMEM;
+	}
+
+	if (EVP_DigestSignInit_ex(mctx, NULL, NULL, NULL, NULL, pkey, NULL) != 1) {
+		ret = -EIO;
+		goto out;
+	}
+
+	if (EVP_DigestSign(mctx, NULL, &slen, msg, msg_len) != 1) {
+		ret = -EIO;
+		goto out;
+	}
+
+	sig = malloc(slen);
+	if (!sig) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	if (EVP_DigestSign(mctx, sig, &slen, msg, msg_len) != 1) {
+		free(sig);
+		ret = -EIO;
+		goto out;
+	}
+
+	*sigp = sig;
+	*sig_len = slen;
+
+out:
+	EVP_MD_CTX_free(mctx);
+	free(msg);
+
+	return ret;
+}
+
+int mldsa_sign(struct image_sign_info *info,
+	       const struct image_region region[],
+	       int region_count, uint8_t **sigp, uint *sig_len)
+{
+	EVP_PKEY *key = NULL;
+	int ret;
+
+	if (!info || !region || region_count <= 0 || !sigp || !sig_len)
+		return -EINVAL;
+
+	ret = mldsa_pem_get_privkey(info->keydir, info->keyname, &key);
+	if (ret)
+		return ret;
+
+	ret = mldsa_sign_with_key(key, region, region_count, sigp, sig_len);
+
+	EVP_PKEY_free(key);
+
+	return ret;
+}
+
+static int mldsa_verify_with_key(EVP_PKEY *pkey,
+				 const struct image_region region[],
+				 int region_count, const uint8_t *sig, uint sig_len)
+{
+	EVP_MD_CTX *mctx;
+	uint8_t *msg = NULL;
+	size_t msg_len = 0;
+	int ret;
+
+	if (sig_len != MLDSA87_SIG_BYTES) {
+		fprintf(stderr, "Bad signature length %u (expected %u)\n",
+			sig_len, MLDSA87_SIG_BYTES);
+		return -EINVAL;
+	}
+
+	ret = mldsa_get_message(region, region_count, &msg, &msg_len);
+	if (ret)
+		return ret;
+
+	mctx = EVP_MD_CTX_new();
+	if (!mctx) {
+		free(msg);
+		return -ENOMEM;
+	}
+
+	if (EVP_DigestVerifyInit_ex(mctx, NULL, NULL, NULL, NULL, pkey, NULL) != 1) {
+		ret = -EIO;
+		goto out;
+	}
+
+	if (EVP_DigestVerify(mctx, sig, sig_len, msg, msg_len) != 1)
+		ret = -EBADMSG;
+
+out:
+	EVP_MD_CTX_free(mctx);
+	free(msg);
+
+	return ret;
+}
+
+int mldsa_verify(struct image_sign_info *info,
+		 const struct image_region region[], int region_count,
+		 uint8_t *sig, uint sig_len)
+{
+	EVP_PKEY *key = NULL;
+	int ret;
+
+	if (!info || !region || region_count <= 0 || !sig || !sig_len)
+		return -EINVAL;
+
+	ret = mldsa_get_pubkey_from_fdt(info, &key);
+	if (ret)
+		return ret;
+
+	ret = mldsa_verify_with_key(key, region, region_count, sig, sig_len);
+
+	EVP_PKEY_free(key);
+
+	return ret;
+}
+
+int mldsa_add_verify_data(struct image_sign_info *info, void *keydest)
+{
+	uint8_t pk[MLDSA87_PK_BYTES] = { 0 };
+	EVP_PKEY *key = NULL;
+	size_t pk_len = 0;
+	int parent, node;
+	int ret;
+
+	if (!info || !info->name || !info->keyname || !info->keydir ||
+	    !info->crypto || !keydest)
+		return -EINVAL;
+
+	ret = mldsa_pem_get_pubkey(info->keydir, info->keyname, &key);
+	if (ret)
+		return ret;
+
+	if (EVP_PKEY_get_octet_string_param(key, OSSL_PKEY_PARAM_PUB_KEY,
+					    pk, sizeof(pk), &pk_len) != 1) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (pk_len != info->crypto->key_len) {
+		fprintf(stderr, "bad public key length %zu (expected %d)\n",
+			pk_len, info->crypto->key_len);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	parent = fdt_subnode_offset(keydest, 0, FIT_SIG_NODENAME);
+	if (parent == -FDT_ERR_NOTFOUND)
+		parent = fdt_add_subnode(keydest, 0, FIT_SIG_NODENAME);
+	if (parent < 0) {
+		ret = parent;
+		goto out;
+	}
+
+	node = fdt_subnode_offset(keydest, parent, info->keyname);
+	if (node == -FDT_ERR_NOTFOUND)
+		node = fdt_add_subnode(keydest, parent, info->keyname);
+	if (node < 0) {
+		ret = node;
+		goto out;
+	}
+
+	ret = fdt_setprop_string(keydest, node, FIT_KEY_HINT, info->keyname);
+	if (ret)
+		goto out;
+
+	ret = fdt_setprop(keydest, node, "mldsa,pubkey", pk, pk_len);
+	if (ret)
+		goto out;
+
+	ret = fdt_setprop_string(keydest, node, FIT_ALGO_PROP, info->name);
+	if (ret)
+		goto out;
+
+	if (info->require_keys) {
+		ret = fdt_setprop_string(keydest, node, FIT_KEY_REQUIRED,
+					 info->require_keys);
+	}
+
+out:
+	EVP_PKEY_free(key);
+	if (ret == -FDT_ERR_NOSPACE)
+		ret = -ENOSPC;
+	if (ret)
+		return ret;
+
+	return node;
+}
