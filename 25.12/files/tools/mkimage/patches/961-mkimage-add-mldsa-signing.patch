+#ifndef _MLDSA_H
+#define _MLDSA_H
+
+#include <image.h>
+
+/**
+ * mldsa_sign() - Sign FIT regions with ML-DSA
+ *
+ * @info:		Key and FIT information
+ * @region:		Image regions to sign (the message)
+ * @region_count:	Number of regions
+ * @sigp:		Set to an allocated buffer holding the signature
+ * @sig_len:		Set to the signature length
+ *
+ * Return: 0 on success, -ve on error. Caller frees *sigp.
+ */
+int mldsa_sign(struct image_sign_info *info, const struct image_region region[],
+	       int region_count, uint8_t **sigp, uint *sig_len);
+
+/**
+ * mldsa_add_verify_data() - Add verification information to FDT
+ *
+ * @info:	Key and FIT information
+ * @keydest:	Destination FDT blob for public key data
+ *
+ * Return: node offset written on success, -ENOSPC if out of space, other -ve
+ *	on error.
+ */
+int mldsa_add_verify_data(struct image_sign_info *info, void *keydest);
+
+/**
+ * mldsa_verify() - Verify a ML-DSA signature against FIT regions
+ *
+ * @info:		Key and FIT information
+ * @region:		Image regions that were signed
+ * @region_count:	Number of regions
+ * @sig:		Signature
+ * @sig_len:		Number of bytes in signature
+ *
+ * Return: 0 if verified, -ve on error.
+ */
+int mldsa_verify(struct image_sign_info *info,
+		 const struct image_region region[], int region_count,
+		 uint8_t *sig, uint sig_len);
+
+/* ML-DSA-87 (FIPS 204 level 5) sizes, in bytes */
+#define MLDSA87_PK_BYTES	2592
+#define MLDSA87_SK_BYTES	4896
+#define MLDSA87_SIG_BYTES	4627
+
+#endif /* _MLDSA_H */
