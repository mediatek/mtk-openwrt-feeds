+/*
+ * MTK_SIP_EMERG_MEM_DUMP - Do emergency memory dump thru. ethernet
+ *
+ * parameters
+ * @x1:		reboot after memory dump
+ *
+ * no return
+ */
+#define MTK_SIP_EMERG_MEM_DUMP			0xC2000540
+
+/* core dump info */
+#define MEMDUMP_CORE_VER			2
+#define MEMDUMP_F_PRECISE_CPU_CONTEXT		BIT(0)
+
+/* parameters */
+#define MIN_RSVD_MEM_RANGES			8
+
+struct memdump_core_info {
+	u32 crc;
+	u32 len;
+	u32 ver;
+	u32 nr_cpus;
+	u32 nr_mem_ranges;
+	u32 panic_cpu;			/* v2 */
+	uintptr_t note_buf_pa;
+	size_t note_buf_size;
+	uintptr_t vmcoreinfo_note_pa;
+	size_t vmcoreinfo_note_size;
+	uintptr_t kernel_va;
+	uintptr_t kernel_pa;
+	size_t kernel_size;
+	uintptr_t mem_ranges_pa;
+	uintptr_t panic_regs_pa;	/* v2 */
+	u32 panic_regs_valid;		/* v2 */
+	u32 flags;			/* v2 */
+};
+
+struct memdump_mem_range {
+	u64 va_start;
+	u64 pa_start;
+	u64 pa_end;
+};
+
+struct crash_mem_priv {
+	unsigned int nr_ranges;
+	unsigned int max_ranges;
+	struct memdump_mem_range *ranges;
+};
+
+static struct memdump_core_info *mdump_core_info;
+static struct pt_regs *mdump_panic_regs;
+static size_t core_info_size;
+static bool warn_max_range;
+static DEFINE_PER_CPU(bool, mdump_panic_info_saved);
+
+static int log_ram_headers_callback(struct resource *res, void *arg)
+{
+	struct crash_mem_priv *cmem = arg;
+
+	if (cmem->nr_ranges >= cmem->max_ranges) {
+		if (!warn_max_range) {
+			pr_warn("Memory range in dump is truncated\n");
+			warn_max_range = true;
+		}
+		return -ENOSPC;
+	}
+
+	cmem->ranges[cmem->nr_ranges].va_start = (u64)__va(res->start);
+	cmem->ranges[cmem->nr_ranges].pa_start = res->start;
+	cmem->ranges[cmem->nr_ranges].pa_end = res->end;
+	cmem->nr_ranges++;
+
+	return 0;
+}
+
+static DEFINE_PER_CPU_SHARED_ALIGNED(struct pt_regs, mdump_cpu_regs);
+
+static int prepare_mdump_core_info(void)
+{
+	struct memdump_mem_range *mem_ranges;
+	struct crash_mem_priv cmpriv;
+	size_t len, used_size;
+	uintptr_t *note_buf;
+	int ret;
+	u32 cpu;
+
+	mdump_core_info->ver = MEMDUMP_CORE_VER;
+	mdump_core_info->nr_cpus = NR_CPUS;
+	mdump_core_info->panic_cpu = smp_processor_id();
+	mdump_core_info->flags = MEMDUMP_F_PRECISE_CPU_CONTEXT;
+
+	note_buf = (uintptr_t *)((uintptr_t)mdump_core_info + sizeof(*mdump_core_info));
+	if (crash_notes) {
+		mdump_core_info->note_buf_pa = __pa(note_buf);
+		mdump_core_info->note_buf_size = sizeof(note_buf_t);
+
+		for_each_present_cpu(cpu) {
+			note_buf[cpu] = per_cpu_ptr_to_phys(per_cpu_ptr(crash_notes, cpu));
+		}
+	} else {
+		mdump_core_info->note_buf_pa = 0;
+		mdump_core_info->note_buf_size = 0;
+	}
+
+	if (vmcoreinfo_note) {
+		mdump_core_info->vmcoreinfo_note_pa = paddr_vmcoreinfo_note();
+		mdump_core_info->vmcoreinfo_note_size = VMCOREINFO_NOTE_SIZE;
+	} else {
+		mdump_core_info->vmcoreinfo_note_pa = 0;
+		mdump_core_info->vmcoreinfo_note_size = 0;
+	}
+
+	mdump_core_info->kernel_va = (uintptr_t)_text;
+	mdump_core_info->kernel_pa = __pa_symbol(_text);
+	mdump_core_info->kernel_size = _end - _text;
+
+	mem_ranges = (struct memdump_mem_range *)((uintptr_t)note_buf + NR_CPUS * sizeof(uintptr_t));
+	used_size = (uintptr_t)mem_ranges - (uintptr_t)mdump_core_info;
+
+	mdump_core_info->mem_ranges_pa = __pa(mem_ranges);
+
+	cmpriv.max_ranges = (core_info_size - used_size) / sizeof(struct memdump_mem_range);
+	cmpriv.nr_ranges = 0;
+	cmpriv.ranges = mem_ranges;
+
+	ret = walk_system_ram_res(0, -1, &cmpriv,
+				  log_ram_headers_callback);
+	if (ret)
+		return ret;
+
+	mdump_core_info->nr_mem_ranges = cmpriv.nr_ranges;
+
+	for_each_possible_cpu(cpu)
+		memcpy(&mdump_panic_regs[cpu + 1],
+		       per_cpu_ptr(&mdump_cpu_regs, cpu),
+		       sizeof(*mdump_panic_regs));
+
+	dcache_clean_inval_poc((unsigned long)mdump_panic_regs,
+			       (unsigned long)&mdump_panic_regs[NR_CPUS + 1]);
+
+	mdump_core_info->panic_regs_pa = __pa(mdump_panic_regs);
+
+	len = sizeof(*mdump_core_info) +
+	      NR_CPUS * sizeof(uintptr_t) +
+	      cmpriv.nr_ranges * sizeof(struct memdump_mem_range);
+
+	mdump_core_info->len = len;
+
+	mdump_core_info->crc = 0;
+	mdump_core_info->crc = crc32(0xffffffff, mdump_core_info, len) ^ 0xffffffff;
+
+	dcache_clean_inval_poc((unsigned long)mdump_core_info, (unsigned long)mdump_core_info + len);
+
+	return 0;
+}
+
+void arm64_atf_memory_dump(int reboot_timeout)
+{
+	struct arm_smccc_res res;
+	uintptr_t core_pa = 0;
+
+	if (!mdump_core_info || !mdump_panic_regs) {
+		pr_err("Memory dump core info not available\n");
+	} else if (!prepare_mdump_core_info()) {
+		core_pa = __pa(mdump_core_info);
+	}
+
+	pr_emerg("Starting Memory dump SMCC\n");
+
+	arm_smccc_smc(MTK_SIP_EMERG_MEM_DUMP, reboot_timeout, core_pa,
+		      0, 0, 0, 0, 0, &res);
+
+	pr_err("Memory dump SMCC failed\n");
+}
+
+noinline void arm64_atf_memory_dump_save_info(struct pt_regs *regs)
+{
+	struct pt_regs *saved_regs = (struct pt_regs *)mdump_panic_regs;
+	struct pt_regs fixed_regs;
+	u32 cpu;
+
+	if (!mdump_core_info || !mdump_panic_regs ||
+	    this_cpu_read(mdump_panic_info_saved))
+		return;
+
+	crash_setup_regs(&fixed_regs, regs);
+	if (!regs) {
+		fixed_regs.regs[29] = (unsigned long)__builtin_frame_address(1);
+		fixed_regs.sp = fixed_regs.regs[29];
+		fixed_regs.pc = fixed_regs.regs[30];
+	}
+	if (vmcoreinfo_note)
+		crash_save_vmcoreinfo();
+
+	/* for crashing cpu */
+	cpu = smp_processor_id();
+	if (crash_notes)
+		crash_save_cpu(&fixed_regs, cpu);
+
+	memcpy(saved_regs, &fixed_regs, sizeof(fixed_regs));
+
+	dcache_clean_inval_poc((unsigned long)saved_regs, (unsigned long)saved_regs + sizeof(*regs));
+
+	mdump_core_info->panic_regs_valid = true;
+
+	arm64_atf_memory_dump_save_cpu_regs(&fixed_regs, cpu);
+	this_cpu_write(mdump_panic_info_saved, true);
+}
+
+void arm64_atf_memory_dump_save_cpu_regs(struct pt_regs *regs, unsigned int cpu)
+{
+	struct pt_regs *saved_regs;
+
+	if (!regs || !mdump_panic_regs || cpu >= NR_CPUS)
+		return;
+
+	saved_regs = per_cpu_ptr(&mdump_cpu_regs, cpu);
+
+	memcpy(saved_regs, regs, sizeof(*regs));
+
+	dcache_clean_inval_poc((unsigned long)saved_regs,
+			       (unsigned long)(saved_regs + 1));
+}
+
+void arm64_atf_memory_dump_clean_cache(void)
+{
+	u64 clidr = read_sysreg(clidr_el1);
+	u64 csselr = read_sysreg(csselr_el1);
+	u64 mmfr2 = read_cpuid(ID_AA64MMFR2_EL1);
+	bool ccidx;
+	unsigned int level;
+
+	ccidx = ((mmfr2 >> ID_AA64MMFR2_EL1_CCIDX_SHIFT) & 0xf) != 0;
+
+	dsb(sy);
+
+	for (level = 0; level < CLIDR_LOC(clidr); level++) {
+		u64 ccsidr, num_sets, num_ways;
+		unsigned int ctype, line_shift, way_shift = 0;
+		u64 set, way;
+
+		ctype = CLIDR_CTYPE(clidr, level + 1);
+		if (ctype != 2 && ctype != 3 && ctype != 4)
+			continue;
+
+		write_sysreg(level << 1, csselr_el1);
+		isb();
+		ccsidr = read_sysreg(ccsidr_el1);
+
+		line_shift = (ccsidr & 0x7) + 4;
+		if (ccidx) {
+			num_sets = ((ccsidr >> 32) & GENMASK_ULL(23, 0)) + 1;
+			num_ways = ((ccsidr >> 3) & GENMASK_ULL(20, 0)) + 1;
+		} else {
+			num_sets = ((ccsidr >> 13) & GENMASK_ULL(14, 0)) + 1;
+			num_ways = ((ccsidr >> 3) & GENMASK_ULL(9, 0)) + 1;
+		}
+
+		if (num_ways > 1)
+			way_shift = __builtin_clz((unsigned int)(num_ways - 1));
+
+		for (way = 0; way < num_ways; way++) {
+			for (set = 0; set < num_sets; set++) {
+				u64 setway = (level << 1) |
+					     (set << line_shift);
+
+				if (num_ways > 1)
+					setway |= way << way_shift;
+				asm volatile("dc csw, %0" : : "r" (setway));
+			}
+		}
+		dsb(sy);
+	}
+
+	write_sysreg(csselr, csselr_el1);
+	isb();
+}
+
+static void *__init alloc_zero_pages(size_t size, u32 *retorder)
+{
+	struct page *page;
+	u32 order;
+
+	order = get_order(size);
+
+	page = alloc_pages(GFP_KERNEL | __GFP_ZERO, order);
+	if (!page)
+		return NULL;
+
+	if (retorder)
+		*retorder = order;
+
+	return page_address(page);
+}
+
+static int __init get_nr_ram_ranges_callback(struct resource *res, void *arg)
+{
+	unsigned int *nr_ranges = arg;
+
+	(*nr_ranges)++;
+	return 0;
+}
+
+static int __init memdump_core_info_init(void)
+{
+	u32 core_order, nr_ranges = 0;
+	size_t size;
+
+	walk_system_ram_res(0, -1, &nr_ranges, get_nr_ram_ranges_callback);
+	nr_ranges += MIN_RSVD_MEM_RANGES;
+
+	size = sizeof(struct memdump_core_info);
+	size += NR_CPUS * sizeof(uintptr_t);
+	size += nr_ranges * sizeof(struct memdump_mem_range);
+
+	mdump_core_info = (struct memdump_core_info *)alloc_zero_pages(size, &core_order);
+	if (!mdump_core_info) {
+		pr_warn("Memory allocation for memdump_core_info failed\n");
+		return -ENOMEM;
+	}
+
+	core_info_size = (1UL << core_order) * PAGE_SIZE;
+
+	size = (NR_CPUS + 1) * sizeof(struct pt_regs);
+	mdump_panic_regs = (struct pt_regs *)alloc_zero_pages(size, NULL);
+	if (!mdump_panic_regs) {
+		pr_warn("Memory allocation for pt_regs failed\n");
+		free_pages((unsigned long)mdump_core_info, core_order);
+		mdump_core_info = NULL;
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
+static_assert(sizeof(uintptr_t) == 8);
+static_assert(sizeof(size_t) == 8);
+static_assert(sizeof(struct memdump_core_info) == 104);
+static_assert(offsetof(struct memdump_core_info, crc) == 0);
+static_assert(offsetof(struct memdump_core_info, len) == 4);
+static_assert(offsetof(struct memdump_core_info, ver) == 8);
+static_assert(offsetof(struct memdump_core_info, nr_cpus) == 12);
+static_assert(offsetof(struct memdump_core_info, nr_mem_ranges) == 16);
+static_assert(offsetof(struct memdump_core_info, panic_cpu) == 20);
+static_assert(offsetof(struct memdump_core_info, note_buf_pa) == 24);
+static_assert(offsetof(struct memdump_core_info, note_buf_size) == 32);
+static_assert(offsetof(struct memdump_core_info, vmcoreinfo_note_pa) == 40);
+static_assert(offsetof(struct memdump_core_info, vmcoreinfo_note_size) == 48);
+static_assert(offsetof(struct memdump_core_info, kernel_va) == 56);
+static_assert(offsetof(struct memdump_core_info, kernel_pa) == 64);
+static_assert(offsetof(struct memdump_core_info, kernel_size) == 72);
+static_assert(offsetof(struct memdump_core_info, mem_ranges_pa) == 80);
+static_assert(offsetof(struct memdump_core_info, panic_regs_pa) == 88);
+static_assert(offsetof(struct memdump_core_info, panic_regs_valid) == 96);
+static_assert(offsetof(struct memdump_core_info, flags) == 100);
+static_assert(sizeof(struct memdump_mem_range) == 24);
+static_assert(offsetof(struct memdump_mem_range, va_start) == 0);
+static_assert(offsetof(struct memdump_mem_range, pa_start) == 8);
+static_assert(offsetof(struct memdump_mem_range, pa_end) == 16);
+static_assert(sizeof(struct pt_regs) == 336);
+static_assert(offsetof(struct pt_regs, user_regs) == 0);
+static_assert(offsetof(struct pt_regs, orig_x0) == 272);
+static_assert(offsetof(struct pt_regs, sdei_ttbr1) == 288);
+static_assert(offsetof(struct pt_regs, pmr_save) == 296);
+static_assert(offsetof(struct pt_regs, stackframe) == 304);
+static_assert(offsetof(struct pt_regs, lockdep_hardirqs) == 320);
+static_assert(offsetof(struct pt_regs, exit_rcu) == 328);
+
+subsys_initcall_sync(memdump_core_info_init);
