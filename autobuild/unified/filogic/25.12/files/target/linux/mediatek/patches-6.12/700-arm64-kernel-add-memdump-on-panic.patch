+#include <linux/gfp.h>
+#include <linux/mm.h>
+#include <linux/arm-smccc.h>
+#include <linux/printk.h>
+#include <linux/crash_core.h>
+#include <linux/ioport.h>
+#include <linux/reboot.h>
+#include <linux/crc32.h>
+#include <linux/kexec.h>
+#include <linux/percpu.h>
+#include <asm/kexec.h>
