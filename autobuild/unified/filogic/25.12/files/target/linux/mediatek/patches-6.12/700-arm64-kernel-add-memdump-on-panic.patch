+#define CONFIG_KEXEC_CORE	1
+
+#include <linux/kernel.h>
+#include <linux/gfp.h>
+#include <linux/mm.h>
+#include <linux/arm-smccc.h>
+#include <linux/printk.h>
+#include <linux/crash_core.h>
+#include <linux/ioport.h>
+#include <linux/reboot.h>
