+static unsigned long mdump_position_mask = BIT(MTK_MEMDUMP_DUMP_DEFAULT);
+static unsigned long mdump_panic_mask = BIT(MTK_MEMDUMP_PANIC_SYSRQ);
+static DEFINE_PER_CPU(bool, mdump_panic_requested);
+static DEFINE_PER_CPU(struct pt_regs *, mdump_panic_source_regs);
+
+int mtk_memdump_set_dump_enabled(enum mtk_memdump_dump_position position,
+				  bool enabled)
+{
+	if ((unsigned int)position >= MTK_MEMDUMP_DUMP_POSITION_MAX)
+		return -EINVAL;
+
+	if (enabled)
+		set_bit(position, &mdump_position_mask);
+	else
+		clear_bit(position, &mdump_position_mask);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_memdump_set_dump_enabled);
+
+bool mtk_memdump_get_dump_enabled(enum mtk_memdump_dump_position position)
+{
+	if ((unsigned int)position >= MTK_MEMDUMP_DUMP_POSITION_MAX)
+		return false;
+
+	return test_bit(position, &mdump_position_mask);
+}
+EXPORT_SYMBOL_GPL(mtk_memdump_get_dump_enabled);
+
+int mtk_memdump_set_panic_enabled(enum mtk_memdump_panic_type type,
+				  bool enabled)
+{
+	if ((unsigned int)type >= MTK_MEMDUMP_PANIC_MAX)
+		return -EINVAL;
+
+	if (enabled)
+		set_bit(type, &mdump_panic_mask);
+	else
+		clear_bit(type, &mdump_panic_mask);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_memdump_set_panic_enabled);
+
+bool mtk_memdump_get_panic_enabled(enum mtk_memdump_panic_type type)
+{
+	if ((unsigned int)type >= MTK_MEMDUMP_PANIC_MAX)
+		return false;
+
+	return test_bit(type, &mdump_panic_mask);
+}
+EXPORT_SYMBOL_GPL(mtk_memdump_get_panic_enabled);
+
+void mtk_memdump_panic_notify(enum mtk_memdump_panic_type type,
+			      struct pt_regs *regs)
+{
+	if (!mtk_memdump_get_panic_enabled(type))
+		return;
+
+	preempt_disable_notrace();
+	this_cpu_write(mdump_panic_source_regs, regs);
+	this_cpu_write(mdump_panic_requested, true);
+}
+
+void mtk_memdump_panic_force(struct pt_regs *regs)
+{
+	preempt_disable_notrace();
+	this_cpu_write(mdump_panic_source_regs, regs);
+	this_cpu_write(mdump_panic_requested, true);
+}
+
+bool mtk_memdump_panic_triggered(void)
+{
+	return this_cpu_read(mdump_panic_requested);
+}
+
+struct pt_regs *mtk_memdump_get_panic_regs(void)
+{
+	return this_cpu_read(mdump_panic_source_regs);
+}
 
