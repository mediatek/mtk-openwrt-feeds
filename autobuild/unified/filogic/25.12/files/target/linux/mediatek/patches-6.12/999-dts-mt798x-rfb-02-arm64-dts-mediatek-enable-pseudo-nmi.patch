---
arm64: dts: mediatek: enable pseudo-NMI for filogic

Enable GICv3 pseudo-NMI support for the devices selected by the unified
build and all MediaTek filogic RFBs. This allows the crash-stop NMI
fallback to interrupt CPUs which do not respond to the initial regular IPI.
---

--- a/arch/arm64/boot/dts/mediatek/mt7981-rfb.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7981-rfb.dts
@@ -18,7 +18,7 @@
 
 	chosen: chosen {
 		stdout-path = "serial0:115200n8";
-		bootargs-append = " root=/dev/fit0 rootwait";
+		bootargs-append = " irqchip.gicv3_pseudo_nmi=1 root=/dev/fit0 rootwait";
 	};
 
 	memory@40000000 {
--- a/arch/arm64/boot/dts/mediatek/mt7981-rfb-spim-nand.dtso
+++ b/arch/arm64/boot/dts/mediatek/mt7981-rfb-spim-nand.dtso
@@ -8,7 +8,7 @@
