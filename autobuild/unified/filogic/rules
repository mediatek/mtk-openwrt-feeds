. ${ab_global}/loglevel.sh

list_add_after $(hooks autobuild_prepare) platform_change_kernel_config filogic_change_kernel_config
list_add_after $(hooks autobuild_prepare) filogic_change_kernel_config change_kernel_flowoffload_conf
list_add_after $(hooks autobuild_prepare) filogic_change_kernel_config change_kernel_security_config
list_add_after $(hooks autobuild_prepare) filogic_change_kernel_config change_kernel_kdb_config
list_append $(hooks autobuild_prepare) airoha_firmware_install
list_add_after $(hooks autobuild_prepare) airoha_firmware_install copy_phy_firmware

if [ -n "${internal_build}" ]; then
	. "${ab_root}/global-dev/internal.sh"
fi

if test x"${hqa_set}" == x"yes"; then
	. "${ab_global}/hqa.sh"
fi

if test x"${bootloader_set}" == x"yes"; then
	. "${ab_global}/bootloader.sh"
fi

if test x"${optee}" == x"yes"; then
	list_add_after $(hooks autobuild_prepare) platform_change_openwrt_config platform_enable_optee_config
	list_add_after $(hooks do_build) build_openwrt platform_build_optee_rpmb
fi

if test x"${secure_boot}" == x"yes"; then
	list_add_after $(hooks autobuild_prepare) platform_change_openwrt_config platform_enable_security_config
fi

help_add_line "  hqa - Enable HQA test support."
help_add_line "  optee - Enable optee"
help_add_line "  bootloader - Enable build BL2/FIP from github release"
help_add_line "  secure_boot - Enable secure_boot, including signing, anti-rollback and firmware encryption"

platform_change_openwrt_config() {
	# Enable the following packages for eMMC QVL
	openwrt_config_enable CONFIG_PACKAGE_fio
	openwrt_config_enable CONFIG_PACKAGE_lsblk
	openwrt_config_enable CONFIG_PACKAGE_sfdisk
	openwrt_config_enable CONFIG_PACKAGE_mmc-utils
}

filogic_change_kernel_config() {
	extra_firmware="airoha/EthMD32.dm.bin airoha/EthMD32.DSP.bin airoha/an8811hb/EthMD32_CRC.DM.bin airoha/an8811hb/EthMD32_CRC.DSP.bin as21x1x_fw.bin as22x1x_fw.bin "
	extra_firmware+="Rhe-05.06-Candidate9-AQR_Mediatek_23B_P5_ID45824_LCLVER1.cld AQR-G4_v5.7.0-AQR_EVB_Generic_X3410_StdCfg_MDISwap_USX_ID46316_VER2148.cld "

	# Base configs
	kernel_config_enable CONFIG_COMMON_CLK_MT7987
	kernel_config_enable CONFIG_PINCTRL_MT7987
	kernel_config_enable CONFIG_HOTPLUG_CPU
	kernel_config_enable CONFIG_MT753X_GSW
	kernel_config_disable CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE
	kernel_config_enable CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE
	kernel_config_disable CONFIG_PCIEASPM_PERFORMANCE
	kernel_config_enable CONFIG_PCIEASPM_POWER_SUPERSAVE

	# APSoC related configs
	kernel_config_enable CONFIG_EXTRA_FIRMWARE "\"${extra_firmware}\""
	kernel_config_enable CONFIG_EXTRA_FIRMWARE_DIR "\"drivers/base/firmware_loader/builtin\""
	kernel_config_enable CONFIG_AIR_EN8811H_PHY
	kernel_config_enable CONFIG_AIR_EN8811H_PHY_DEBUGFS
	kernel_config_enable CONFIG_MT753X_GSW
	kernel_config_enable CONFIG_AN8855_GSW
	kernel_config_disable CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE
	kernel_config_enable CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE
	kernel_config_enable CONFIG_CPU_FREQ_THERMAL
	kernel_config_enable CONFIG_THERMAL_EMULATION
	kernel_config_enable CONFIG_LEDS_PWM_MULTICOLOR
	kernel_config_enable CONFIG_SENSORS_PWM_FAN
	kernel_config_enable CONFIG_SRAM
	kernel_config_enable CONFIG_NET_DSA_MXL862
	kernel_config_enable CONFIG_NET_DSA_TAG_MXL862
	kernel_config_enable CONFIG_NET_DSA_TAG_MXL862_8021Q
	kernel_config_disable CONFIG_MEDIATEK_NETSYS_V2
	kernel_config_disable CONFIG_MEDIATEK_NETSYS_V3
	kernel_config_enable CONFIG_PTP_1588_CLOCK
	kernel_config_enable CONFIG_AS21XXX_PHY
	kernel_config_enable CONFIG_AQUANTIA_PHY
	kernel_config_enable CONFIG_AIROHA_AN8801_PHY
	kernel_config_enable CONFIG_AIR_AN8811HB_PHY
	kernel_config_enable CONFIG_AIR_AN8811HB_PHY_DEBUGFS
	kernel_config_enable CONFIG_MTK_DEVAPC
	kernel_config_enable CONFIG_IIO
	kernel_config_enable CONFIG_ZTS8032
	kernel_config_enable CONFIG_ZTS8232
	kernel_config_enable CONFIG_PHY_MTK_PCIE
	kernel_config_enable CONFIG_MTK_EMIMPU
}

# KDB (Kernel Debugger) is a built-in Linux kernel debugger
# that allows developers to inspect and debug the kernel
# directly from the console without a separate host machine.
#
# Enable KDB:
# echo 0 > /proc/sys/kernel/panic
# echo ttyS0,115200 > /sys/module/kgdboc/parameters/kgdboc
# ubus call system watchdog '{"magicclose":true,"stop":true}'
#
# Disable KDB:
# echo 3 > /proc/sys/kernel/panic
# echo "" > /sys/module/kgdboc/parameters/kgdboc
# ubus call system watchdog '{"stop":false}'
change_kernel_kdb_config() {
	kernel_config_enable CONFIG_TTY
	kernel_config_enable CONFIG_VT
	kernel_config_disable CONFIG_VT_CONSOLE
	kernel_config_disable CONFIG_CONSOLE_TRANSLATIONS
	kernel_config_disable CONFIG_VT_HW_CONSOLE_BINDING
	kernel_config_enable CONFIG_KGDB
	kernel_config_enable CONFIG_KGDB_HONOUR_BLOCKLIST
	kernel_config_enable CONFIG_KGDB_KDB
	kernel_config_enable CONFIG_KGDB_SERIAL_CONSOLE
	kernel_config_disable CONFIG_SERIAL_KGDB_NMI
	kernel_config_disable CONFIG_KGDB_TESTS
	kernel_config_disable CONFIG_KDB_KEYBOARD
	kernel_config_enable CONFIG_MAGIC_SYSRQ_SERIAL
	kernel_config_disable CONFIG_KDB_DEFAULT_ENABLE
	kernel_config_enable CONFIG_KDB_DEFAULT_ENABLE 0x1
	kernel_config_disable CONFIG_KDB_CONTINUE_CATASTROPHIC
	kernel_config_enable CONFIG_KDB_CONTINUE_CATASTROPHIC 0
}

change_kernel_flowoffload_conf () {
	kernel_config_enable CONFIG_NETFILTER
	kernel_config_enable CONFIG_NETFILTER_INGRESS
	kernel_config_enable CONFIG_NF_CONNTRACK
	kernel_config_enable CONFIG_NF_FLOW_TABLE
}

change_kernel_security_config() {
	kernel_config_enable CONFIG_SYSTEM_TRUSTED_KEYS "\"\""
	kernel_config_disable CONFIG_SYSTEM_EXTRA_CERTIFICATE
	kernel_config_disable CONFIG_SECONDARY_TRUSTED_KEYRING
	kernel_config_disable CONFIG_PKCS8_PRIVATE_KEY_PARSER
	kernel_config_disable CONFIG_PKCS7_TEST_KEY
	kernel_config_disable CONFIG_FIPS_SIGNATURE_SELFTEST
}

platform_enable_optee_config() {
	openwrt_config_enable CONFIG_PACKAGE_optee-os-mt7981
	openwrt_config_enable CONFIG_PACKAGE_optee-os-mt7986
	openwrt_config_enable CONFIG_PACKAGE_optee-os-mt7987
	openwrt_config_enable CONFIG_PACKAGE_optee-os-mt7988
	openwrt_config_enable CONFIG_PACKAGE_optee-apps
	openwrt_config_enable CONFIG_PACKAGE_optee-test
	openwrt_config_enable CONFIG_OPTEE_FW_ENC_EARLY_TA
	openwrt_config_enable CONFIG_OPTEE_MTK_TEST
	openwrt_config_enable CONFIG_PACKAGE_optee-pkcs11
}

platform_build_optee_rpmb() {
	# clean optee package
	exec_log "make -C \"${openwrt_root}\" package/mtk/optee/optee-mediatek/clean V=s"

	# add RPMB config
	openwrt_config_enable CONFIG_OPTEE_RPMB_FS
	openwrt_config_enable CONFIG_OPTEE_RPMB_WRITE_KEY

	# defconfig
	make_defconfig

	# re-build optee
	exec_log "make -C \"${openwrt_root}\" package/mtk/optee/optee-mediatek/compile V=s"

	# revert RPMB config
	openwrt_config_disable CONFIG_OPTEE_RPMB_FS
	openwrt_config_disable CONFIG_OPTEE_RPMB_WRITE_KEY

	# defconfig
	make_defconfig

	# clean optee package
	exec_log "make -C \"${openwrt_root}\" package/mtk/optee/optee-mediatek/clean V=s"
}

platform_enable_security_config() {
	openwrt_config_enable CONFIG_MTK_SECURE_BOOT
	openwrt_config_enable CONFIG_MTK_ANTI_ROLLBACK
	openwrt_config_enable CONFIG_MTK_FW_ENC
}

airoha_firmware_install() {
	if test x"${internal_sync_set}" != x"yes"; then
		exec_log "make -C \"${openwrt_root}\" V=s package/firmware/linux-firmware/{download,clean,prepare}"
	fi
}

copy_phy_firmware() {
	if test x"${internal_sync_set}" != x"yes"; then
		firmware_dir="target/linux/mediatek/files-${kernel_ver}/drivers/base/firmware_loader/builtin"

		# ensure the PHY firmware is located in the same directory when compiling the kernel's built-in PHY driver
		copy_file "${openwrt_root}/package/kernel/as2xxxx/firmware/as21x1x_fw.bin" "${firmware_dir}"
		copy_file "${openwrt_root}/package/kernel/as2xxxx/firmware/as22x1x_fw.bin" "${firmware_dir}"
		copy_file "${openwrt_root}/package/kernel/aqr10g-phy-fw/files/Rhe-05.06-Candidate9-AQR_Mediatek_23B_P5_ID45824_LCLVER1.cld" "${firmware_dir}"
		copy_file "${openwrt_root}/package/kernel/aqr10g-phy-fw/files/AQR-G4_v5.7.0-AQR_EVB_Generic_X3410_StdCfg_MDISwap_USX_ID46316_VER2148.cld" "${firmware_dir}"
		copy_file "${openwrt_root}/package/kernel/airoha-phy-fw/files/an8811hb/EthMD32_CRC.DM.bin" "${firmware_dir}/airoha/an8811hb"
		copy_file "${openwrt_root}/package/kernel/airoha-phy-fw/files/an8811hb/EthMD32_CRC.DSP.bin" "${firmware_dir}/airoha/an8811hb"

		# copy linux firmware
		linux_firmware_path=$(openwrt_get_package_build_dir "package/firmware/linux-firmware")
		copy_files "${linux_firmware_path}/airoha" "${firmware_dir}/airoha"
	fi
}
