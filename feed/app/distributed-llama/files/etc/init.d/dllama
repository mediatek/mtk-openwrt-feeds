# Distributed Llama. Starts the 'api' (root) and/or 'worker' instance
# described in /etc/config/dllama. A node is usually one or the other.

START=95
STOP=10

USE_PROCD=1
NAME=dllama

start_api() {
	local enabled model tokenizer host port threads bft max_seq_len workers extra_args

	config_get_bool enabled api enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get model       api model       /mnt/models/dllama_model_qwen3_1.7b_q40.m
	config_get tokenizer   api tokenizer   /mnt/models/dllama_tokenizer_qwen3_1.7b.t
	config_get host        api host        0.0.0.0
	config_get port        api port        9990
	config_get threads     api threads     4
	config_get bft         api buffer_float_type q80
	config_get max_seq_len api max_seq_len 4096
	config_get workers     api workers     ""
	config_get extra_args  api extra_args  ""

	if [ ! -f "$model" ] || [ ! -f "$tokenizer" ]; then
		logger -t "$NAME" "model/tokenizer missing ($model, $tokenizer) - see /etc/config/dllama for the download URLs - api not starting"
		return 1
	fi

	procd_open_instance api
	procd_set_param command /usr/bin/dllama-api \
		--model "$model" \
		--tokenizer "$tokenizer" \
		--host "$host" \
		--port "$port" \
		--nthreads "$threads" \
		--buffer-float-type "$bft" \
		--max-seq-len "$max_seq_len"
	# both are intentionally word-split. --workers must never be passed empty:
	# the arg parser reads name/value pairs and a valueless --workers desyncs it.
	[ -n "$workers" ] && procd_append_param command --workers $workers
	[ -n "$extra_args" ] && procd_append_param command $extra_args
	# restart on crash, but back off so an OOM loop does not hammer the box
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_set_param stdout 1
	procd_close_instance
}

start_worker() {
	local enabled port threads extra_args

	config_get_bool enabled worker enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get port       worker port       9999
	config_get threads    worker threads    4
	config_get extra_args worker extra_args ""

	procd_open_instance worker
	procd_set_param command /usr/bin/dllama worker \
		--port "$port" \
		--nthreads "$threads"
	[ -n "$extra_args" ] && procd_append_param command $extra_args
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_set_param stdout 1
	procd_close_instance
}

start_service() {
	config_load dllama
	start_api
	start_worker
}

service_triggers() {
	procd_add_reload_trigger "dllama"
}
